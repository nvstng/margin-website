---
import GuideVideo from './guide-video.astro';
import allocationImage from '../assets/images/how-it-works-allocation.webp';
import dashboardImage from '../assets/images/how-it-works-dashboard.webp';
import importPosterEn from '../assets/images/video-importing-holdings-and-trades-en.webp';
import importPosterHi from '../assets/images/video-importing-holdings-and-trades-hi.webp';
import dcfPosterEn from '../assets/images/video-dcf-valuation-grid-en.webp';
import dcfPosterHi from '../assets/images/video-dcf-valuation-grid-hi.webp';
import agentsPosterEn from '../assets/images/video-agents-en.webp';
import agentsPosterHi from '../assets/images/video-agents-hi.webp';

const tabs = [
  {
    id: 'records',
    label: 'Records',
    heading: 'Bring in what your broker exports',
    body: 'Pick the trading account, then upload its holdings and tradebook from Zerodha, Groww, Upstox or AngelOne, or from any other broker through the generic CSV layout. The dividend statement and the funds statement come in as uploads of their own, and the consistency check names any split or bonus the tradebook never recorded before you trust a return.',
    detail: 'Several accounts, across brokers, read as one portfolio',
    videos: [
      { language: 'en', youtubeId: 'O4OShXdaGr0', poster: importPosterEn },
      { language: 'hi', youtubeId: 'ZggRQQLLD8w', poster: importPosterHi },
    ],
    links: [
      { label: 'Importing holdings and trades', href: '/guides/importing-holdings-and-trades' },
      { label: 'The funds statement', href: '/guides/funds-statement-ledger' },
      { label: 'The consistency check', href: '/guides/consistency-check' },
    ],
  },
  {
    id: 'value',
    label: 'Value',
    heading: 'Research a business and put a number on it',
    body: 'Start from the stock’s story, and screen names card by card so the ones you mark Yes or Maybe land in your Screened list. Build a DCF on a grid that projects forward from the trailing twelve months, with the cells you can edit highlighted, or run a reverse DCF to read the growth today’s price already implies.',
    detail: 'Every valuation is saved per stock, with a note on what you were underwriting',
    videos: [
      { language: 'en', youtubeId: 'qsX0tn_CFrE', poster: dcfPosterEn },
      { language: 'hi', youtubeId: 'Pnn-gBIDzhw', poster: dcfPosterHi },
    ],
    links: [
      { label: 'Using the DCF valuation grid', href: '/guides/dcf-valuation-grid' },
      { label: 'The stock’s story as a starting point', href: '/guides/stock-story-research-starting-point' },
      { label: 'Qualitative screening', href: '/guides/qualitative-screening' },
    ],
  },
  {
    id: 'decide',
    label: 'Decide',
    heading: 'Set the prices you act at and the size you want',
    body: 'Create your own price types, such as Buy, Add, Reduce and Exit, and derive each anchor from a valuation you saved. On the Allocation screen, set the target cost you are building towards and each stock’s share of it, and read the gap against today’s weight before you size the next buy.',
    detail: 'Anchors work on stocks you do not own yet',
    image: allocationImage,
    imageAlt: 'The Allocation screen with target allocation and target cost beside current weight for each stock',
    links: [
      { label: 'Setting price anchors', href: '/guides/price-anchors' },
      { label: 'Setting and reading target allocation', href: '/guides/target-allocation' },
    ],
  },
  {
    id: 'track',
    label: 'Track',
    heading: 'Read the whole portfolio on one row per holding',
    body: 'The dashboard puts the expected return from each saved valuation beside the unallocated amount and any price anchor you add as a column. The summary gives XIRR since inception, over a trailing stretch, a calendar year or a financial year, and the Unrealised Gains screen shows the tax a sale today would attract.',
    detail: 'End-of-day prices from the NSE and BSE bhavcopy',
    image: dashboardImage,
    imageAlt: 'The Margin dashboard with expected return and unallocated amount for each holding',
    links: [
      { label: 'Reading the dashboard columns', href: '/guides/dashboard-columns' },
      { label: 'Tracking expected returns', href: '/guides/tracking-expected-returns-dashboard' },
      { label: 'Tax if sold today', href: '/guides/tax-if-sold-today' },
    ],
  },
  {
    id: 'agent',
    label: 'Automate',
    heading: 'Hand the repeat work to your AI agent',
    body: 'Create an API token in Settings and point an agent you run, such as Claude Code or Codex, at go.marginapp.in/llms.txt. It reads your broker and Margin side by side, shows you the difference, and writes only after you say go ahead.',
    detail: 'Tokens can be revoked at any time',
    videos: [
      { language: 'en', youtubeId: 'LGeJ3uXkvg8', poster: agentsPosterEn },
      { language: 'hi', youtubeId: 'IZdRCyHhClE', poster: agentsPosterHi },
    ],
    links: [{ label: 'Recipes for agents', href: '/agents' }],
  },
];
---

<section class="py-24 lg:py-32">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="mb-16 reveal">
      <p class="text-xs text-gold-400 tracking-widest uppercase mb-3">Workflow</p>
      <h2 class="font-display text-4xl md:text-5xl font-light text-cream">
        How it <em class="font-semibold not-italic">works</em>
      </h2>
    </div>

    <div class="reveal reveal-delay-1" data-tabs>
      <div class="flex gap-1 p-1 rounded-lg bg-navy-800/60 border border-border mb-8 w-fit max-w-full overflow-x-auto">
        {tabs.map((tab, i) => (
          <button
            class={`tab-btn shrink-0 px-3 sm:px-5 py-2.5 text-sm font-medium rounded-md transition-all duration-200 ${i === 0 ? 'bg-navy-600 text-cream' : 'text-muted hover:text-ink'}`}
            data-tab={tab.id}
          >
            {tab.label}
          </button>
        ))}
      </div>

      <div class="relative">
        {tabs.map((tab, i) => (
          <div
            class={`tab-panel ${i === 0 ? 'block' : 'hidden'} grid grid-cols-1 lg:grid-cols-5 gap-10 items-center`}
            data-panel={tab.id}
          >
            <div class="lg:col-span-2">
              <div class="flex items-center justify-center w-10 h-10 rounded-full border border-gold-400/30 text-gold-400 font-display text-lg font-semibold mb-6">
                {i + 1}
              </div>
              <h3 class="font-display text-3xl font-light text-cream mb-4 leading-tight">
                {tab.heading}
              </h3>
              <p class="text-muted leading-relaxed mb-4">{tab.body}</p>
              <p class="text-xs text-gold-400 tracking-wide">{tab.detail}</p>
              <ul class="mt-6 flex flex-col gap-2 border-t border-border pt-5">
                {tab.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="inline-flex items-center gap-2 text-sm text-muted hover:text-cream transition-colors group"
                    >
                      {link.label}
                      <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                      </svg>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
            <div class="lg:col-span-3">
              {tab.videos ? (
                <GuideVideo title={tab.heading} videos={tab.videos} />
              ) : (
                <div class="rounded-xl border border-border bg-navy-800/40 overflow-hidden">
                  <div class="flex items-center gap-1.5 px-4 py-3 border-b border-border">
                    <span class="w-2.5 h-2.5 rounded-full bg-navy-600"></span>
                    <span class="w-2.5 h-2.5 rounded-full bg-navy-600"></span>
                    <span class="w-2.5 h-2.5 rounded-full bg-navy-600"></span>
                    <span class="ml-2 text-xs text-muted">margin · {tab.label.toLowerCase()}</span>
                  </div>
                  <img
                    src={tab.image.src}
                    alt={tab.imageAlt}
                    width={tab.image.width}
                    height={tab.image.height}
                    loading="lazy"
                    decoding="async"
                    class="w-full"
                  />
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const buttons = document.querySelectorAll('.tab-btn');
  const panels = document.querySelectorAll('.tab-panel');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.getAttribute('data-tab');

      buttons.forEach((b) => {
        b.classList.remove('bg-navy-600', 'text-cream');
        b.classList.add('text-muted');
      });
      btn.classList.add('bg-navy-600', 'text-cream');
      btn.classList.remove('text-muted');

      panels.forEach((panel) => {
        const id = panel.getAttribute('data-panel');
        if (id !== target) panel.querySelectorAll('.guide-video').forEach((video) => video.dispatchEvent(new Event('video:reset')));
        panel.classList.toggle('hidden', id !== target);
        panel.classList.toggle('block', id === target);
      });
    });
  });
</script>
