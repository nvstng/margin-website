---
import { getCollection } from 'astro:content';

const [posts, guides, recipes] = await Promise.all([
  getCollection('blog'),
  getCollection('guide'),
  getCollection('recipe'),
]);

const latestPost = posts.sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
)[0];

const latestGuide = guides.sort((a, b) => a.data.order - b.data.order)[0];

const cards = [
  {
    eyebrow: 'Guides',
    meta: `${guides.length} guides`,
    title: latestGuide.data.title,
    body: latestGuide.data.description,
    href: `/guides/${latestGuide.slug}`,
  },
  {
    eyebrow: 'Insights',
    meta: `${posts.length} essays`,
    title: latestPost.data.title,
    body: latestPost.data.description,
    href: `/blog/${latestPost.slug}`,
  },
  {
    eyebrow: 'Agent recipes',
    meta: `${recipes.length} recipes`,
    title: 'Hand the repetitive part to an agent',
    body:
      'Importing holdings, recording a year of dividends, moving a spreadsheet valuation in. Each recipe ends with a skill you can copy and adapt.',
    href: '/agents',
  },
];
---

<section class="py-24 lg:py-32 bg-navy-800/20">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="reveal flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-12">
      <div class="gold-line">
        <p class="text-xs text-gold-400 tracking-widest uppercase mb-3">Reading</p>
        <h2 class="font-display text-4xl md:text-5xl font-light text-cream">
          Written for<br /><em class="font-semibold not-italic">people who do this work</em>
        </h2>
      </div>
      <p class="text-muted text-sm leading-relaxed max-w-md">
        Guides take one feature and the investing concept behind it. Insights are about how
        investing works and are worth reading whether or not you use Margin. Recipes are for
        automating the clerical part.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      {cards.map((card, i) => (
        <a
          href={card.href}
          class={`reveal reveal-delay-${i + 1} group flex flex-col bg-navy-800/40 border border-border hover:border-gold-400/30 rounded-xl p-7 transition-all duration-300 hover:bg-navy-800/70`}
        >
          <div class="flex items-center gap-3 mb-4">
            <p class="text-xs text-gold-400 tracking-widest uppercase">{card.eyebrow}</p>
            <span class="w-1 h-1 rounded-full bg-border"></span>
            <p class="text-xs text-muted">{card.meta}</p>
          </div>
          <h3 class="font-display text-xl font-light text-cream group-hover:text-gold-200 transition-colors duration-200 mb-3 leading-snug">
            {card.title}
          </h3>
          <p class="text-sm text-muted leading-relaxed flex-1">{card.body}</p>
        </a>
      ))}
    </div>

    <div class="reveal mt-8 text-center">
      <a href="/learn" class="inline-flex items-center gap-2 text-sm font-medium text-gold-400 hover:text-gold-300 transition-colors group">
        Everything there is to read
        <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
        </svg>
      </a>
    </div>
  </div>
</section>
