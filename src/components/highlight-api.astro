---
const SIGNUP_URL = 'https://go.marginapp.in';
---

<section class="py-24 lg:py-32 overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <div class="reveal lg:order-2">
        <p class="text-xs text-gold-400 tracking-widest uppercase mb-4">API & AI Agents</p>
        <h2 class="font-display text-4xl md:text-5xl font-light text-cream leading-tight mb-6">
          Let an agent do<br />
          <em class="font-semibold not-italic">the data entry</em>
        </h2>
        <p class="text-muted leading-relaxed mb-6">
          Create an API token and point your AI agent — or any script — at Margin.
          It can upload your holdings, tradebooks, and stock lists on your behalf,
          so you never have to wrangle broker files by hand.
        </p>
        <p class="text-muted leading-relaxed mb-8">
          Agents fetch setup instructions from a machine-readable <code class="text-gold-300">llms.txt</code>.
          Tokens never expire and you can revoke any of them, any time.
        </p>
        <div class="flex flex-wrap gap-2 mb-8">
          {['Personal API tokens', 'AI-agent friendly', 'llms.txt', 'Revoke anytime'].map((tag) => (
            <span class="px-3 py-1 text-xs text-muted border border-border rounded-full">{tag}</span>
          ))}
        </div>
        <a
          href={SIGNUP_URL}
          class="inline-flex items-center gap-2 text-sm font-medium text-gold-400 hover:text-gold-300 transition-colors group"
        >
          Create an API token
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>

      <div class="reveal reveal-delay-2 lg:order-1">
        <div class="relative rounded-xl border border-border bg-navy-800/40 overflow-hidden">
          <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-gold-400/30 to-transparent"></div>
          <div class="flex items-center gap-1.5 px-4 py-3 border-b border-border">
            <span class="w-2.5 h-2.5 rounded-full bg-navy-600"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-navy-600"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-navy-600"></span>
            <span class="ml-2 text-xs text-muted">agent · upload</span>
          </div>
          <div class="p-6 font-mono text-xs leading-relaxed">
            <p class="text-muted"># point your agent at</p>
            <p class="text-gold-300 mb-4">go.marginapp.in/llms.txt</p>
            <p class="text-muted mb-1"><span class="text-emerald-400">POST</span> /web/holdings</p>
            <p class="text-muted mb-1">Authorization: Bearer <span class="text-cream">mgn_••••••••</span></p>
            <p class="text-muted mb-4">Content-Type: text/csv</p>
            <div class="rounded-lg bg-navy-950/60 border border-emerald-400/20 p-4 flex items-center gap-3">
              <span class="w-2 h-2 rounded-full bg-emerald-400 shrink-0"></span>
              <span class="text-cream">142 holdings imported across 3 accounts</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
