---
import marginLogo from '../assets/images/margin-logo.png';

const SIGNUP_URL = 'https://go.marginapp.in';
---

<nav id="main-nav" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300" data-nav>
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="flex items-center justify-between h-18 py-4">
      <a href="/" class="flex-shrink-0">
        <img
          src={marginLogo.src}
          alt="Margin"
          width={marginLogo.width}
          height={marginLogo.height}
          class="h-10 w-auto"
        />
      </a>

      <ul class="hidden md:flex items-center gap-8">
        <li><a href="/#features" class="text-sm text-muted hover:text-ink transition-colors duration-200 tracking-wide">Features</a></li>
        <li><a href="/agents" class="text-sm text-muted hover:text-ink transition-colors duration-200 tracking-wide">Agents</a></li>
        <li><a href="/#pricing" class="text-sm text-muted hover:text-ink transition-colors duration-200 tracking-wide">Pricing</a></li>
        <li><a href="/learn" class="text-sm text-muted hover:text-ink transition-colors duration-200 tracking-wide">Learn</a></li>
        <li><a href="/company" class="text-sm text-muted hover:text-ink transition-colors duration-200 tracking-wide">Company</a></li>
      </ul>

      <div class="flex items-center gap-4">
        <a
          href={SIGNUP_URL}
          class="hidden md:inline-flex items-center px-5 py-2 text-sm font-medium text-navy-900 bg-gold-400 hover:bg-gold-300 rounded transition-colors duration-200 tracking-wide"
        >
          Start for free
        </a>
        <button
          id="nav-toggle"
          class="md:hidden p-2 text-muted hover:text-ink transition-colors"
          aria-label="Toggle menu"
          aria-controls="mobile-menu"
          aria-expanded="false"
        >
          <svg id="icon-open" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
          </svg>
          <svg id="icon-close" class="w-5 h-5 hidden" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div id="mobile-menu" class="hidden md:hidden border-t border-border bg-navy-900">
    <div class="px-6 py-4 flex flex-col gap-4">
      <a href="/#features" class="text-sm text-muted hover:text-ink transition-colors">Features</a>
      <a href="/agents" class="text-sm text-muted hover:text-ink transition-colors">Agents</a>
      <a href="/#pricing" class="text-sm text-muted hover:text-ink transition-colors">Pricing</a>
      <a href="/learn" class="text-sm text-muted hover:text-ink transition-colors">Learn</a>
      <a href="/company" class="text-sm text-muted hover:text-ink transition-colors">Company</a>
      <a href={SIGNUP_URL} class="inline-flex items-center justify-center px-5 py-2.5 text-sm font-medium text-navy-900 bg-gold-400 rounded transition-colors">
        Start for free
      </a>
    </div>
  </div>
</nav>

<script>
  const nav = document.querySelector('[data-nav]') as HTMLElement;
  const toggle = document.getElementById('nav-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  window.addEventListener('scroll', () => {
    if (window.scrollY > 40) {
      nav.classList.add('bg-navy-900/95', 'backdrop-blur-md', 'border-b', 'border-border');
    } else {
      nav.classList.remove('bg-navy-900/95', 'backdrop-blur-md', 'border-b', 'border-border');
    }
  });

  function setMenuOpen(open: boolean) {
    mobileMenu?.classList.toggle('hidden', !open);
    iconOpen?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
    toggle?.setAttribute('aria-expanded', String(open));
  }

  toggle?.addEventListener('click', () => {
    setMenuOpen(mobileMenu?.classList.contains('hidden') ?? false);
  });

  document.querySelectorAll('#mobile-menu a').forEach((link) => {
    link.addEventListener('click', () => setMenuOpen(false));
  });
</script>
