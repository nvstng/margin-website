---
const machineTools = [
  { x: 306, title: 'File system', note: 'skill, token' },
  { x: 440, title: 'Browser', note: 'broker login' },
  { x: 574, title: 'Web search', note: 'filings, news' },
];

const steps = [
  { tone: 'gold', title: 'Fetch the contract', body: 'The agent reads llms.txt from Margin before anything else, so it works against the current API rather than a remembered copy.' },
  { tone: 'emerald', title: 'Read both sides', body: 'It pulls holdings from your broker through your browser session, and the record Margin already holds through your token.' },
  { tone: 'amber', title: 'Show you the diff', body: 'What differs is laid out as a proposed write and the agent stops there. Nothing has changed yet on either side.' },
  { tone: 'amber', title: 'Write on your go-ahead', body: 'Margin checks the payload first, so a rejected write leaves the account exactly as it was.' },
  { tone: 'emerald', title: 'Read back and verify', body: 'The agent reads the summary again and matches it against what it sent. The figures it reports are the ones the web app shows you.' },
];

const dots = {
  gold: 'bg-gold-400',
  emerald: 'bg-emerald-400',
  amber: 'bg-amber-400',
};
---

<div class="overflow-x-auto -mx-6 px-6 lg:mx-0 lg:px-0">
  <svg
    viewBox="0 0 720 1050"
    class="w-full min-w-[720px] font-sans"
    role="img"
    aria-label="How you, the agent on your machine, your broker and Margin connect"
  >
    <defs>
      <marker id="arrow-muted" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 0 L 10 5 L 0 10 z" class="fill-muted" />
      </marker>
      <marker id="arrow-gold" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 0 L 10 5 L 0 10 z" class="fill-gold-400" />
      </marker>
    </defs>

    <rect x="282" y="34" width="428" height="290" rx="14" class="fill-navy-800 stroke-border" fill-opacity="0.25" stroke-dasharray="5 5" />
    <text x="298" y="58" class="fill-gold-400 text-[12px] tracking-[0.2em] uppercase">Your machine</text>

    <rect x="70" y="80" width="160" height="100" rx="10" class="fill-navy-800 stroke-gold-400" stroke-opacity="0.4" />
    <text x="150" y="113" text-anchor="middle" class="fill-cream text-[19px] font-display font-semibold">You</text>
    <text x="150" y="137" text-anchor="middle" class="fill-muted text-[12.5px]">prompt the agent</text>
    <text x="150" y="154" text-anchor="middle" class="fill-muted text-[12.5px]">read each diff</text>
    <text x="150" y="171" text-anchor="middle" class="fill-muted text-[12.5px]">say go ahead</text>

    <rect x="300" y="70" width="400" height="110" rx="10" class="fill-navy-800 stroke-border" />
    <text x="500" y="103" text-anchor="middle" class="fill-cream text-[19px] font-display font-semibold">AI agent</text>
    <text x="500" y="127" text-anchor="middle" class="fill-muted text-[13px]">Claude Code, Codex or any agent</text>
    <text x="500" y="145" text-anchor="middle" class="fill-muted text-[13px]">on your subscription, not Margin's</text>
    <text x="500" y="168" text-anchor="middle" class="fill-gold-300 text-[13px]">mgn_ token kept in a private file</text>

    <line x1="230" y1="100" x2="300" y2="100" class="stroke-muted" stroke-width="1.5" marker-end="url(#arrow-muted)" />
    <text x="265" y="92" text-anchor="middle" class="fill-muted text-[12px]">prompt</text>
    <line x1="300" y1="130" x2="230" y2="130" class="stroke-muted" stroke-width="1.5" marker-end="url(#arrow-muted)" />
    <text x="265" y="150" text-anchor="middle" class="fill-muted text-[12px]">the diff</text>

    <path d="M 500 180 V 206 M 366 206 H 634 M 366 206 V 232 M 500 206 V 232 M 634 206 V 232" class="stroke-border" fill="none" stroke-width="1.5" />
    {machineTools.map((tool) => (
      <>
        <rect x={tool.x} y="232" width="120" height="72" rx="8" class="fill-navy-800 stroke-border" />
        <text x={tool.x + 60} y="263" text-anchor="middle" class="fill-cream text-[14px]">{tool.title}</text>
        <text x={tool.x + 60} y="284" text-anchor="middle" class="fill-muted text-[12px]">{tool.note}</text>
      </>
    ))}
    <text x="298" y="314" class="fill-muted text-[12px] italic">only the access you grant</text>

    <line x1="500" y1="304" x2="500" y2="384" class="stroke-muted" stroke-width="1.5" marker-start="url(#arrow-muted)" marker-end="url(#arrow-muted)" />
    <text x="512" y="350" class="fill-muted text-[12px]">your login, never sent to Margin</text>

    <rect x="335" y="384" width="330" height="84" rx="10" class="fill-navy-800 stroke-border" />
    <text x="500" y="415" text-anchor="middle" class="fill-cream text-[17px] font-display font-semibold">Your broker</text>
    <text x="500" y="441" text-anchor="middle" class="fill-muted text-[12.5px]">Zerodha · Groww · Upstox · AngelOne</text>

    <path d="M 300 172 H 256 V 552" class="stroke-gold-400" fill="none" stroke-width="1.5" marker-start="url(#arrow-gold)" marker-end="url(#arrow-gold)" />
    <text x="246" y="440" text-anchor="end" class="fill-gold-400 text-[12px]">read · write</text>
    <text x="246" y="462" text-anchor="end" class="fill-gold-400 text-[12px]">computed figures</text>

    <rect x="100" y="508" width="610" height="480" rx="14" class="fill-navy-800 stroke-border" fill-opacity="0.25" stroke-dasharray="5 5" />
    <text x="118" y="532" class="fill-gold-400 text-[12px] tracking-[0.2em] uppercase">Margin</text>

    <rect x="155" y="552" width="500" height="112" rx="10" class="fill-navy-800 stroke-gold-400" stroke-opacity="0.4" />
    <text x="405" y="585" text-anchor="middle" class="fill-cream text-[19px] font-display font-semibold">API</text>
    <text x="405" y="609" text-anchor="middle" class="fill-muted text-[13px]">go.marginapp.in</text>
    <text x="405" y="627" text-anchor="middle" class="fill-muted text-[13px]">reads free, writes checked first</text>
    <text x="405" y="650" text-anchor="middle" class="fill-gold-300 text-[13px]">llms.txt: the contract, every run</text>

    <line x1="405" y1="664" x2="405" y2="700" class="stroke-muted" stroke-width="1.5" marker-start="url(#arrow-muted)" marker-end="url(#arrow-muted)" />

    <rect x="155" y="700" width="500" height="124" rx="10" class="fill-navy-800 stroke-border" />
    <text x="405" y="731" text-anchor="middle" class="fill-cream text-[18px] font-display font-semibold">Your data</text>
    <text x="405" y="756" text-anchor="middle" class="fill-muted text-[12.5px]">holdings · trades · dividends</text>
    <text x="405" y="774" text-anchor="middle" class="fill-muted text-[12.5px]">funds statement · valuations</text>
    <text x="405" y="792" text-anchor="middle" class="fill-muted text-[12.5px]">lists · boards · verdicts</text>
    <text x="405" y="812" text-anchor="middle" class="fill-muted text-[12.5px]">every figure is computed here</text>

    <line x1="405" y1="824" x2="405" y2="860" class="stroke-muted" stroke-width="1.5" marker-start="url(#arrow-muted)" marker-end="url(#arrow-muted)" />

    <rect x="155" y="860" width="500" height="104" rx="10" class="fill-navy-800 stroke-border" />
    <text x="405" y="891" text-anchor="middle" class="fill-cream text-[18px] font-display font-semibold">Web app</text>
    <text x="405" y="916" text-anchor="middle" class="fill-muted text-[12.5px]">the same figures, and the operations closed to a token:</text>
    <text x="405" y="936" text-anchor="middle" class="fill-muted text-[12.5px]">clearing, deleting, reading row by row</text>

    <path d="M 76 180 V 1010 H 405 V 968" class="stroke-muted" fill="none" stroke-width="1.5" marker-end="url(#arrow-muted)" />
    <text x="405" y="1036" text-anchor="middle" class="fill-muted text-[12px]">sign in to check what the agent wrote, and for the operations closed to a token</text>
  </svg>
</div>

<div class="grid grid-cols-1 md:grid-cols-5 gap-4 mt-12">
  {steps.map((step, i) => (
    <div class="bg-navy-800/30 border border-border rounded-xl p-5">
      <div class="flex items-center gap-2 mb-3">
        <span class={`w-2 h-2 rounded-full ${dots[step.tone as keyof typeof dots]}`}></span>
        <span class="text-[11px] text-muted tracking-widest uppercase">Step {i + 1}</span>
      </div>
      <h3 class="font-display text-lg text-cream mb-2 leading-snug">{step.title}</h3>
      <p class="text-muted text-sm leading-relaxed">{step.body}</p>
    </div>
  ))}
</div>
