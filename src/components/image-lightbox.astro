---
---

<div class="lightbox" id="lightbox" hidden>
  <button class="lightbox-close" type="button" aria-label="Close">&times;</button>
  <img class="lightbox-image" alt="" />
  <p class="lightbox-caption"></p>
</div>

<style is:global>
  .prose-margin img {
    cursor: zoom-in;
  }
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 2rem;
    background: rgba(3, 8, 15, 0.94);
    cursor: zoom-out;
  }
  .lightbox[hidden] {
    display: none;
  }
  .lightbox-image {
    max-width: 100%;
    max-height: calc(100vh - 7rem);
    object-fit: contain;
    border: 1px solid #1A2D4A;
    border-radius: 8px;
    background: #000;
  }
  .lightbox-caption {
    margin: 0;
    font-size: 0.85rem;
    font-style: italic;
    color: #8AABCC;
    text-align: center;
    max-width: 60ch;
  }
  .lightbox-caption:empty {
    display: none;
  }
  .lightbox-close {
    position: absolute;
    top: 1rem;
    right: 1.25rem;
    width: 2.5rem;
    height: 2.5rem;
    font-size: 1.75rem;
    line-height: 1;
    color: #8AABCC;
    background: transparent;
    border: 1px solid #1A2D4A;
    border-radius: 999px;
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s;
  }
  .lightbox-close:hover {
    color: #E8B84B;
    border-color: rgba(232, 184, 75, 0.4);
  }
</style>

<script>
  const lightbox = document.getElementById('lightbox') as HTMLElement;
  const image = lightbox.querySelector<HTMLImageElement>('.lightbox-image')!;
  const caption = lightbox.querySelector<HTMLElement>('.lightbox-caption')!;

  function open(source: HTMLImageElement) {
    image.src = source.currentSrc || source.src;
    image.alt = source.alt;
    caption.textContent = source.closest('p')?.nextElementSibling?.querySelector('em')?.textContent ?? '';
    lightbox.hidden = false;
    document.body.style.overflow = 'hidden';
  }

  function close() {
    lightbox.hidden = true;
    image.src = '';
    document.body.style.overflow = '';
  }

  document.querySelectorAll<HTMLImageElement>('.prose-margin img').forEach((img) => {
    img.addEventListener('click', () => open(img));
  });
  lightbox.addEventListener('click', close);
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && !lightbox.hidden) close();
  });
</script>
