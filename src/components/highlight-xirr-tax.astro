---
const SIGNUP_URL = 'https://go.marginapp.in';
---

<section class="py-24 lg:py-32 overflow-hidden bg-navy-800/20">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">

      <div class="reveal order-2 lg:order-1">
        <div class="relative rounded-xl border border-border bg-navy-800/60 overflow-hidden">
          <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-gold-400/30 to-transparent"></div>
          <div class="p-6">
            <p class="text-xs text-muted tracking-widest uppercase mb-6">Returns & Tax Summary</p>
            <div class="grid grid-cols-2 gap-3 mb-6">
              {[
                { label: 'Portfolio XIRR', value: '21.3%', positive: true },
                { label: 'Absolute Return', value: '₹3.4L', positive: true },
                { label: 'STCG (15%)', value: '₹8,200', positive: false },
                { label: 'LTCG (10%)', value: '₹12,400', positive: false },
              ].map((stat) => (
                <div class="rounded-lg bg-navy-950/50 border border-border/60 p-4">
                  <p class="text-xs text-muted mb-1">{stat.label}</p>
                  <p class={`font-display text-2xl font-semibold ${stat.positive ? 'text-emerald-400' : 'text-ink'}`}>
                    {stat.value}
                  </p>
                </div>
              ))}
            </div>
            <div class="rounded-lg bg-navy-950/50 border border-border/60 p-4">
              <p class="text-xs text-muted mb-3">Gain Breakdown — Current FY</p>
              <div class="space-y-2">
                {[
                  { label: 'Short-term gains', pct: 40, color: 'bg-amber-400' },
                  { label: 'Long-term gains', pct: 60, color: 'bg-emerald-500' },
                ].map((row) => (
                  <div class="flex items-center gap-3">
                    <div class="flex-1 h-1.5 rounded-full bg-navy-700 overflow-hidden">
                      <div class={`h-full rounded-full ${row.color}`} style={`width: ${row.pct}%`}></div>
                    </div>
                    <span class="text-xs text-muted w-36 shrink-0">{row.label} · {row.pct}%</span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="reveal reveal-delay-2 order-1 lg:order-2">
        <p class="text-xs text-gold-400 tracking-widest uppercase mb-4">Returns & Tax</p>
        <h2 class="font-display text-4xl md:text-5xl font-light text-cream leading-tight mb-6">
          Your returns, your tax —<br />
          <em class="font-semibold not-italic">calculated precisely</em>
        </h2>
        <p class="text-muted leading-relaxed mb-6">
          XIRR gives you the only return number that actually matters — time-weighted,
          accounting for every buy, sell, and dividend across your portfolio.
        </p>
        <p class="text-muted leading-relaxed mb-8">
          Margin also separates Short-Term Capital Gains (STCG) from Long-Term Capital
          Gains (LTCG) and calculates the applicable tax, so you're never surprised
          at the end of the financial year.
        </p>
        <div class="flex flex-wrap gap-2 mb-8">
          {['XIRR', 'STCG 15%', 'LTCG 10%', 'Per stock', 'Per list', 'Full portfolio'].map((tag) => (
            <span class="px-3 py-1 text-xs text-muted border border-border rounded-full">{tag}</span>
          ))}
        </div>
        <a
          href={SIGNUP_URL}
          class="inline-flex items-center gap-2 text-sm font-medium text-gold-400 hover:text-gold-300 transition-colors group"
        >
          See your real returns
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
