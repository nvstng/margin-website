---
import GuideVideo from './guide-video.astro';
import videoPosterEn from '../assets/images/video-hero-en.webp';
import videoPosterHi from '../assets/images/video-hero-hi.webp';

const SIGNUP_URL = 'https://go.marginapp.in';
const YOUTUBE_URL = 'https://www.youtube.com/@margin-fundamental';
const brokerages = ['Zerodha', 'Groww', 'Upstox', 'AngelOne', 'Any broker, generic CSV'];
const exchanges = ['NSE', 'BSE'];
const videos = [
  { language: 'en', youtubeId: 'XZ4_rnf8kl4', poster: videoPosterEn },
  { language: 'hi', youtubeId: 'VoaU9n_OvMA', poster: videoPosterHi },
];
---

<section class="relative min-h-screen flex flex-col justify-center pt-24 pb-16 overflow-hidden">
  <div class="absolute inset-0 bg-dot-grid bg-dot-md opacity-100 pointer-events-none"></div>
  <div class="absolute inset-0 bg-gradient-to-b from-navy-950 via-navy-900/80 to-navy-900 pointer-events-none"></div>
  <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[400px] bg-gold-glow pointer-events-none opacity-60"></div>

  <div class="relative max-w-7xl mx-auto px-6 lg:px-8 text-center">
    <div class="inline-flex items-center gap-2 px-4 py-1.5 mb-8 border border-border rounded-full text-xs text-muted tracking-widest uppercase">
      <span class="w-1.5 h-1.5 rounded-full bg-gold-400 animate-pulse"></span>
      Built for Indian equity investors
    </div>

    <h1 class="font-display text-5xl md:text-6xl lg:text-7xl font-light text-cream leading-tight tracking-tight mb-6">
      Leave the chores to Margin.<br />
      <em class="font-semibold not-italic text-gold-400">Keep the judgement.</em>
    </h1>

    <p class="max-w-2xl mx-auto text-base md:text-lg text-muted leading-relaxed mb-10">
      Margin keeps your books and keeps your valuations, allocation and target prices in order,
      so the decisions are all that's left to you. Your AI agent works from the same data.
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-14">
      <a
        href={SIGNUP_URL}
        class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-3.5 text-sm font-semibold text-navy-900 bg-gold-400 hover:bg-gold-300 rounded transition-all duration-200 tracking-wide shadow-lg shadow-gold-400/10"
      >
        Start for free, no card needed
      </a>
      <a
        href={YOUTUBE_URL}
        target="_blank"
        rel="noopener"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-3.5 text-sm font-medium text-ink border border-border hover:border-gold-400/50 hover:text-gold-300 rounded transition-all duration-200 tracking-wide"
      >
        <svg class="w-4 h-4 text-gold-400" fill="currentColor" viewBox="0 0 24 24">
          <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
        </svg>
        Watch Stock Stories
      </a>
    </div>

    <div class="mx-auto max-w-5xl text-left">
      <GuideVideo title="What Margin does for you" videos={videos} label="Margin in two minutes" eager />
    </div>

    <div class="mt-10 flex flex-col items-center gap-3">
      <p class="text-xs text-muted tracking-widest uppercase">Holdings and trades from</p>
      <div class="flex flex-wrap justify-center gap-2">
        {brokerages.map((b) => (
          <span class="px-3 py-1 text-xs font-medium text-ink border border-border rounded-full bg-navy-800/50">
            {b}
          </span>
        ))}
        <span class="px-1 text-muted self-center text-xs">·</span>
        {exchanges.map((e) => (
          <span class="px-3 py-1 text-xs font-medium text-gold-400 border border-gold-400/20 rounded-full bg-gold-400/5">
            {e}
          </span>
        ))}
      </div>
    </div>
  </div>
</section>
