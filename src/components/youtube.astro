---
const YOUTUBE_URL = 'https://www.youtube.com/@margin-fundamental';
---

<section class="py-24 lg:py-32">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="relative rounded-2xl border border-border bg-navy-800/30 overflow-hidden">
      <div class="absolute inset-0 bg-dot-grid bg-dot-md opacity-50 pointer-events-none"></div>
      <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-gold-400/20 to-transparent"></div>

      <div class="relative px-10 py-16 lg:px-16 lg:py-20 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div class="reveal">
          <p class="text-xs text-gold-400 tracking-widest uppercase mb-4">Stock Stories</p>
          <h2 class="font-display text-4xl md:text-5xl font-light text-cream leading-tight mb-6">
            Fundamental stories,<br />
            <em class="font-semibold not-italic">told clearly</em>
          </h2>
          <p class="text-muted leading-relaxed mb-8">
            Our YouTube channel breaks down Indian stocks through a fundamental lens —
            business quality, valuation, and what the numbers actually mean for long-term investors.
            No noise, no tips.
          </p>
          <a
            href={YOUTUBE_URL}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-3 px-7 py-3.5 text-sm font-medium text-navy-900 bg-gold-400 hover:bg-gold-300 rounded-lg transition-colors duration-200"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
            </svg>
            Watch on YouTube
          </a>
        </div>

        <div class="reveal reveal-delay-2 flex justify-center lg:justify-end">
          <div class="relative">
            <div class="w-64 h-40 rounded-2xl bg-navy-950 border border-border flex items-center justify-center shadow-xl">
              <div class="text-center">
                <div class="w-14 h-14 mx-auto mb-3 rounded-full bg-red-600/90 flex items-center justify-center shadow-lg shadow-red-600/30">
                  <svg class="w-6 h-6 text-white ml-1" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M8 5v14l11-7z"/>
                  </svg>
                </div>
                <p class="text-xs text-muted">@margin-fundamental</p>
              </div>
            </div>
            <div class="absolute -bottom-3 -right-3 w-32 h-20 rounded-xl bg-navy-800 border border-border flex items-center justify-center opacity-60">
              <p class="text-xs text-muted text-center leading-tight px-2">Stock<br/>Stories</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
