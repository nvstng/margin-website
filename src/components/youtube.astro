---
const YOUTUBE_URL = 'https://www.youtube.com/@margin-fundamental';

const videos = [
  { id: 'DYadzT6llyU', kind: 'Stock story' },
  { id: 'VQx7tqjmFzo', kind: 'Stock story' },
  { id: 'lBMbb9rL8gY', kind: 'Industry story' },
];
---

<section class="py-24 lg:py-32">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="relative rounded-2xl border border-border bg-navy-800/30 overflow-hidden">
      <div class="absolute inset-0 bg-dot-grid bg-dot-md opacity-50 pointer-events-none"></div>
      <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-gold-400/20 to-transparent"></div>

      <div class="relative px-6 py-14 sm:px-10 sm:py-16 lg:px-16 lg:py-20">
        <div class="reveal max-w-2xl mb-12">
          <p class="text-xs text-gold-400 tracking-widest uppercase mb-4">Stock &amp; Industry Stories</p>
          <h2 class="font-display text-4xl md:text-5xl font-light text-cream leading-tight mb-6">
            Fundamental stories,<br />
            <em class="font-semibold not-italic">told clearly</em>
          </h2>
          <p class="text-muted leading-relaxed mb-4">
            Our YouTube channel works through Indian businesses one at a time: what the company
            sells, how it earns, what the numbers have done, and what its recent story has been.
            There are no tips and no price calls on the channel.
          </p>
          <p class="text-muted leading-relaxed mb-8">
            The industry stories go a level up, covering the sector dynamics, the competitive
            structure and the forces that decide how long an advantage lasts.
          </p>
          <a
            href={YOUTUBE_URL}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-3 px-7 py-3.5 text-sm font-medium text-navy-900 bg-gold-400 hover:bg-gold-300 rounded-lg transition-colors duration-200"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
            </svg>
            Watch on YouTube
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {videos.map((video, i) => (
            <div class={`reveal reveal-delay-${i + 1}`}>
              <div
                class="video-facade relative rounded-xl overflow-hidden border border-border aspect-video bg-navy-950 cursor-pointer group"
                data-video-id={video.id}
              >
                <img
                  src={`https://i.ytimg.com/vi/${video.id}/hqdefault.jpg`}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover opacity-70 group-hover:opacity-90 transition-opacity duration-300"
                />
                <button
                  type="button"
                  class="absolute inset-0 flex items-center justify-center"
                  aria-label={`Play ${video.kind}`}
                >
                  <span class="flex items-center justify-center w-14 h-14 rounded-full bg-navy-900/80 border border-gold-400/40 group-hover:bg-gold-400 transition-colors duration-300">
                    <svg class="w-6 h-6 text-gold-400 group-hover:text-navy-900 transition-colors duration-300 translate-x-0.5" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M8 5v14l11-7z" />
                    </svg>
                  </span>
                </button>
              </div>
              <p class="text-xs text-muted mt-3">{video.kind}</p>
            </div>
          ))}
        </div>

        <p class="reveal text-xs text-muted mt-6">
          A sample of what is on the channel. More stories go up regularly.
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.video-facade').forEach((facade) => {
    facade.addEventListener('click', () => {
      const id = facade.dataset.videoId;
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube.com/embed/${id}?autoplay=1`;
      iframe.title = 'YouTube video player';
      iframe.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      iframe.allowFullscreen = true;
      iframe.className = 'w-full h-full';
      facade.replaceChildren(iframe);
      facade.classList.remove('cursor-pointer', 'group');
    });
  });
</script>
