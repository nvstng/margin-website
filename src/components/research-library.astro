---
const CONTENT_URL = 'https://go.marginapp.in/content';

const reports = [
  { label: 'Stock Story', desc: 'Why the business matters, financial health, recent story' },
  { label: 'Valuation Normalisation', desc: 'What earnings look like through the cycle' },
  { label: 'Segment Story', desc: 'The business broken down segment by segment' },
  { label: 'Industry Story', desc: 'Sector dynamics and structural forces' },
];

const storySections = [
  'Why the business matters',
  'Financial health',
  "Stock's recent story",
];
---

<section id="research" class="py-24 lg:py-32 overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <div class="reveal">
        <p class="text-xs text-gold-400 tracking-widest uppercase mb-4">Research Library</p>
        <h2 class="font-display text-4xl md:text-5xl font-light text-cream leading-tight mb-6">
          Read the story<br />
          <em class="font-semibold not-italic">behind every number</em>
        </h2>
        <p class="text-muted leading-relaxed mb-6">
          Margin builds structured research reports on Indian stocks — the business, its
          financial health, its recent story, how its valuation looks through the cycle,
          and the industry it competes in.
        </p>
        <p class="text-muted leading-relaxed mb-8">
          Don't see a stock you follow? Request it, and you'll be notified inside Margin
          the moment its research is ready.
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-10">
          {reports.map((r) => (
            <div class="rounded-lg border border-border bg-navy-800/40 p-4">
              <p class="text-sm font-semibold text-cream mb-1">{r.label}</p>
              <p class="text-xs text-muted leading-relaxed">{r.desc}</p>
            </div>
          ))}
        </div>
        <a
          href={CONTENT_URL}
          class="inline-flex items-center gap-2 text-sm font-medium text-gold-400 hover:text-gold-300 transition-colors group"
        >
          Browse the research library
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>

      <div class="reveal reveal-delay-2">
        <div class="relative rounded-xl border border-border bg-navy-800/40 overflow-hidden">
          <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-gold-400/30 to-transparent"></div>
          <div class="flex items-center gap-1.5 px-4 py-3 border-b border-border">
            <span class="w-2.5 h-2.5 rounded-full bg-navy-600"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-navy-600"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-navy-600"></span>
            <span class="ml-2 text-xs text-muted">margin · research</span>
          </div>
          <div class="p-6">
            <p class="text-xs text-muted tracking-widest uppercase mb-2">Stock Story</p>
            <h3 class="font-display text-2xl text-cream mb-6">A leading Indian franchise</h3>
            <div class="space-y-2 mb-6">
              {storySections.map((s, i) => (
                <div class={`flex items-center gap-3 rounded-lg border p-3 ${i === 0 ? 'border-gold-400/30 bg-navy-950/50' : 'border-border/50 bg-navy-950/30'}`}>
                  <span class={`flex items-center justify-center w-6 h-6 rounded-full text-xs font-semibold shrink-0 ${i === 0 ? 'bg-gold-400 text-navy-900' : 'border border-border text-muted'}`}>
                    {i + 1}
                  </span>
                  <span class={`text-sm ${i === 0 ? 'text-cream' : 'text-muted'}`}>{s}</span>
                </div>
              ))}
            </div>
            <div class="space-y-2">
              <div class="h-2 rounded-full bg-navy-700 w-full"></div>
              <div class="h-2 rounded-full bg-navy-700 w-11/12"></div>
              <div class="h-2 rounded-full bg-navy-700 w-4/5"></div>
              <div class="h-2 rounded-full bg-navy-700/60 w-2/3"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
