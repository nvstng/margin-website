---
const SIGNUP_URL = '#signup';
const YOUTUBE_URL = 'https://www.youtube.com/@margin-fundamental';
---

<footer class="border-t border-border">
  <div class="max-w-7xl mx-auto px-6 lg:px-8 py-14">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 mb-12">
      <div class="md:col-span-2">
        <img
          src="/assets/images/margin-logo.png"
          alt="Margin"
          class="h-9 mb-4"
        />
        <p class="text-sm text-muted leading-relaxed max-w-xs">
          Your personal investment cockpit for Indian equities.
          Built for serious investors on NSE & BSE.
        </p>
      </div>
      <div>
        <p class="text-xs text-gold-400 tracking-widest uppercase mb-4">Product</p>
        <ul class="space-y-2.5">
          <li><a href="#features" class="text-sm text-muted hover:text-ink transition-colors">Features</a></li>
          <li><a href="#pricing" class="text-sm text-muted hover:text-ink transition-colors">Pricing</a></li>
          <li><a href="#privacy" class="text-sm text-muted hover:text-ink transition-colors">Privacy</a></li>
          <li><a href={SIGNUP_URL} class="text-sm text-muted hover:text-ink transition-colors">Get started</a></li>
        </ul>
      </div>
      <div>
        <p class="text-xs text-gold-400 tracking-widest uppercase mb-4">Resources</p>
        <ul class="space-y-2.5">
          <li>
            <a href={YOUTUBE_URL} target="_blank" rel="noopener" class="text-sm text-muted hover:text-ink transition-colors">
              Stock Stories on YouTube
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="flex flex-col md:flex-row items-center justify-between gap-4 pt-8 border-t border-border/50">
      <p class="text-xs text-muted">
        © {new Date().getFullYear()} Yuktibyte Products Private Limited. All rights reserved.
      </p>
      <div class="flex items-center gap-1 text-xs text-muted/50">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>All systems operational</span>
      </div>
    </div>
  </div>
</footer>
