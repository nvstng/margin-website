  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" />`,
    title: 'Notes per Stock',
    desc: 'Keep rich text against each stock, and a note against each valuation recording what you were underwriting at the time.',
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M9.568 3H5.25A2.25 2.25 0 0 0 3 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 0 0 5.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 0 0 9.568 3Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M6 6h.008v.008H6V6Z" />`,
    title: 'Stock Tags',
    desc: 'Label by sector, conviction or anything you define, then filter and analyse by the label.',
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18 9 11.25l4.306 4.306a11.95 11.95 0 0 1 5.814-5.518l2.74-1.22m0 0-5.94-2.281m5.94 2.28-2.28 5.941" />`,
    title: 'Stocks of Interest',
    desc: 'Track what you do not hold yet, with price anchors on it, beside what you do.',
  },
];

const exchanges = ['NSE', 'BSE'];
---

<section id="features" class="py-24 lg:py-32">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="mb-16 reveal gold-line">
      <p class="text-xs text-gold-400 tracking-widest uppercase mb-3">Capabilities</p>
      <h2 class="font-display text-4xl md:text-5xl font-light text-cream">
        What Margin<br /><em class="font-semibold not-italic">does</em>
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-px bg-border rounded-xl overflow-hidden">
      {coreFeatures.map((f, i) => (
        <div class={`reveal reveal-delay-${(i % 3) + 1} bg-navy-800 p-8 flex flex-col gap-5 group hover:bg-navy-700/60 transition-colors duration-300`}>
          <div class="w-10 h-10 rounded-lg border border-border flex items-center justify-center group-hover:border-gold-400/30 transition-colors duration-300">
            <svg class="w-5 h-5 text-gold-400" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" set:html={f.icon} />
          </div>
          <div class="flex-1">
            <h3 class="font-display text-xl font-semibold text-cream mb-2">{f.title}</h3>
            <p class="text-sm text-muted leading-relaxed">{f.desc}</p>
          </div>
          {f.badges && (
            <div class="flex flex-wrap gap-1.5">
              {f.badges.map((b) => (
                <span class="px-2 py-0.5 text-xs text-muted border border-border rounded">{b}</span>
              ))}
            </div>
          )}
        </div>
      ))}
    </div>

    <div class="reveal mt-6 flex flex-col sm:flex-row sm:items-center gap-4 rounded-xl border border-border bg-navy-800/30 px-6 py-5">
      <div class="flex gap-2 shrink-0">
        {exchanges.map((e) => (
          <span class="px-3 py-1 text-xs font-medium text-gold-400 border border-gold-400/20 rounded-full bg-gold-400/5">{e}</span>
        ))}
      </div>
      <p class="text-sm text-muted leading-relaxed">
        Every stock on both exchanges is covered. Prices come from the exchange bhavcopy at the close,
        so they are end of day rather than live, and Margin shows you the date of the quote you are reading.
      </p>
    </div>

    <div class="mt-16">
      <p class="text-xs text-gold-400 tracking-widest uppercase mb-6 reveal">Organise and track</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {organising.map((item, i) => (
          <div class={`reveal reveal-delay-${i + 1} p-6 rounded-xl border border-border bg-navy-800/30 hover:bg-navy-800/60 hover:border-gold-400/20 transition-all duration-300`}>
            <div class="mb-4">
              <svg class="w-5 h-5 text-gold-400" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" set:html={item.icon} />
            </div>
            <h3 class="font-display text-lg font-semibold text-cream mb-2">{item.title}</h3>
            <p class="text-sm text-muted leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
