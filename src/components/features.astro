    title: 'Holdings & Trades',
    desc: 'Upload CSV or Excel from four brokerages, or from any other broker through a generic layout. Several files from several accounts are merged for you.',
    badges: ['Zerodha', 'Groww', 'Upstox', 'AngelOne', 'Generic CSV'],
