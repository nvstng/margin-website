---
const coreFeatures = [
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 0 0 6 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0 1 18 16.5h-2.25m-7.5 0h7.5m-7.5 0-1 3m8.5-3 1 3m0 0 .5 1.5m-.5-1.5h-9.5m0 0-.5 1.5m.75-9 3-3 2.148 2.148A12.061 12.061 0 0 1 16.5 7.605" />`,
    title: 'Valuation',
    desc: 'DCF and Reverse DCF. Model your convictions and track them against current price.',
    image: '/assets/images/valuation.png',
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6a7.5 7.5 0 1 0 7.5 7.5h-7.5V6Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 10.5H21A7.5 7.5 0 0 0 13.5 3v7.5Z" />`,
    title: 'Allocation',
    desc: 'Set target cost allocation. Track gaps and live portfolio weight at a glance.',
    image: '/assets/images/upload.png',
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />`,
    title: 'Custom Price Anchors',
    desc: 'Set your Buy, Add, Reduce, or Exit prices. Track every stock against your own thesis.',
    image: '/assets/images/price-anchors.png',
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />`,
    title: 'Holdings & Trades in One Place',
    desc: 'Upload CSV/Excel from Zerodha, Groww, Upstox, or AngelOne. Multiple files, multiple accounts.',
    image: '/assets/images/holdings-trade.png',
    badges: ['Zerodha', 'Groww', 'Upstox', 'AngelOne'],
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M7.5 14.25v2.25m3-4.5v4.5m3-6.75v6.75m3-9v9M6 20.25h12A2.25 2.25 0 0 0 20.25 18V6A2.25 2.25 0 0 0 18 3.75H6A2.25 2.25 0 0 0 3.75 6v12A2.25 2.25 0 0 0 6 20.25Z" />`,
    title: 'Analyse Anything',
    desc: 'XIRR, capital gains, tax — for individual stocks, custom lists, or your entire portfolio.',
    image: '/assets/images/analyse.png',
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 0 1 3 12c0-1.605.42-3.113 1.157-4.418" />`,
    title: 'NSE & BSE Support',
    desc: 'All stocks from both NSE and BSE are supported. No real-time price or fundamentals data.',
    image: '/assets/images/bse-nse.png',
    badges: ['NSE', 'BSE'],
  },
];
---

<section id="features" class="py-24 lg:py-32">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="mb-16 reveal gold-line">
      <p class="text-xs text-gold-400 tracking-widest uppercase mb-3">Capabilities</p>
      <h2 class="font-display text-4xl md:text-5xl font-light text-cream">
        Everything a serious<br /><em class="font-semibold not-italic">investor needs</em>
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-px bg-border rounded-xl overflow-hidden">
      {coreFeatures.map((f, i) => (
        <div class={`reveal reveal-delay-${(i % 3) + 1} bg-navy-800 p-8 flex flex-col gap-5 group hover:bg-navy-700/60 transition-colors duration-300`}>
          <div class="w-10 h-10 rounded-lg border border-border flex items-center justify-center group-hover:border-gold-400/30 transition-colors duration-300">
            <svg class="w-5 h-5 text-gold-400" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" set:html={f.icon} />
          </div>
          <div class="flex-1">
            <h3 class="font-display text-xl font-semibold text-cream mb-2">{f.title}</h3>
            <p class="text-sm text-muted leading-relaxed">{f.desc}</p>
          </div>
          {f.badges && (
            <div class="flex flex-wrap gap-1.5">
              {f.badges.map((b) => (
                <span class="px-2 py-0.5 text-xs text-muted border border-border rounded">{b}</span>
              ))}
            </div>
          )}
          <div class="aspect-video rounded-lg overflow-hidden border border-border/50">
            <img
              src={f.image}
              alt={f.title}
              class="w-full h-full object-cover opacity-70 group-hover:opacity-90 transition-opacity duration-300 scale-105 group-hover:scale-100 transition-transform"
            />
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
