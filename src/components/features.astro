---
import { STAGE_ORDER, stageAnchor } from '../domain/guide';
import HighlightFundsLedger from './highlight-funds-ledger.astro';
import HighlightDividends from './highlight-dividends.astro';
import Screen from './screen.astro';
import ResearchLibrary from './research-library.astro';
import HighlightDcf from './highlight-dcf.astro';
import HighlightReverseDcf from './highlight-reverse-dcf.astro';
import HighlightXirrTax from './highlight-xirr-tax.astro';

const coreFeatures = [
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />`,
    title: 'Holdings & Trades',
    stage: 'Get your records in',
    guide: '/guides/importing-holdings-and-trades',
    desc: 'Upload CSV or Excel from four brokerages, or from any other broker through a generic layout. Several files from several accounts are merged for you.',
    badges: ['Zerodha', 'Groww', 'Upstox', 'AngelOne', 'Generic CSV'],
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.57-.598-3.75h-.152c-3.196 0-6.1-1.25-8.25-3.286Z" />`,
    title: 'Consistency Check',
    stage: 'Get your records in',
    guide: '/guides/consistency-check',
    desc: 'Reconciles what your tradebook says you should hold against what the demat file says you do, and names the splits and bonuses that fell inside a holding period and were never recorded.',
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />`,
    title: 'Custom Price Anchors',
    stage: 'Decide what to buy and sell',
    guide: '/guides/price-anchors',
    desc: 'Set a Buy, Add, Reduce or Exit price on a stock and read where the market sits against it, in a column you named.',
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 7.125C2.25 6.504 2.754 6 3.375 6h6c.621 0 1.125.504 1.125 1.125v3.75c0 .621-.504 1.125-1.125 1.125h-6a1.125 1.125 0 0 1-1.125-1.125v-3.75ZM14.25 8.625c0-.621.504-1.125 1.125-1.125h5.25c.621 0 1.125.504 1.125 1.125v8.25c0 .621-.504 1.125-1.125 1.125h-5.25a1.125 1.125 0 0 1-1.125-1.125v-8.25ZM3.75 16.125c0-.621.504-1.125 1.125-1.125h5.25c.621 0 1.125.504 1.125 1.125v2.25c0 .621-.504 1.125-1.125 1.125h-5.25a1.125 1.125 0 0 1-1.125-1.125v-2.25Z" />`,
    title: 'Research Boards',
    stage: 'Research and value a stock',
    desc: 'Build a board from any stock list and work the names through your own reading cycle: results announced, transcript read, valuation done. Each card carries links to the filing or the transcript.',
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6a7.5 7.5 0 1 0 7.5 7.5h-7.5V6Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 10.5H21A7.5 7.5 0 0 0 13.5 3v7.5Z" />`,
    title: 'Allocation',
    stage: 'Decide what to buy and sell',
    guide: '/guides/target-allocation',
    desc: 'Set a target cost allocation per stock and read the gap against live portfolio weight on the same scale.',
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6ZM3.75 15.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18a2.25 2.25 0 0 1-2.25 2.25H6A2.25 2.25 0 0 1 3.75 18v-2.25ZM13.5 6a2.25 2.25 0 0 1 2.25-2.25H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25a2.25 2.25 0 0 1-2.25-2.25V6ZM13.5 15.75a2.25 2.25 0 0 1 2.25-2.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-2.25A2.25 2.25 0 0 1 13.5 18v-2.25Z" />`,
    title: 'Dashboard',
    stage: 'Track the portfolio',
    guide: '/guides/dashboard-columns',
    desc: 'Each holding carries the expected return read off the valuation behind it, beside whichever price anchors you add as columns.',
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M12 3v17.25m0 0c-1.472 0-2.882.265-4.185.75M12 20.25c1.472 0 2.882.265 4.185.75M18.75 4.97A48.416 48.416 0 0 0 12 4.5c-2.291 0-4.545.16-6.75.47m13.5 0c1.01.143 2.01.317 3 .52m-3-.52 2.62 10.726c.122.499-.106 1.028-.589 1.202a5.988 5.988 0 0 1-2.031.352 5.988 5.988 0 0 1-2.031-.352c-.483-.174-.711-.703-.59-1.202L18.75 4.971Zm-16.5.52c.99-.203 1.99-.377 3-.52m0 0 2.62 10.726c.122.499-.106 1.028-.589 1.202a5.989 5.989 0 0 1-2.031.352 5.989 5.989 0 0 1-2.031-.352c-.483-.174-.711-.703-.59-1.202L5.25 4.971Z" />`,
    title: 'Tax If Sold Today',
    stage: 'Track the portfolio',
    guide: '/guides/tax-if-sold-today',
    desc: 'The unrealised gain on every holding split into short-term and long-term, with the tax each band would attract, and a preview of any quantity you are thinking of selling.',
  },
];

const organising = [
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M8.25 6.75h12M8.25 12h12m-12 5.25h12M3.75 6.75h.007v.008H3.75V6.75Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0ZM3.75 12h.007v.008H3.75V12Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm-.375 5.25h.007v.008H3.75v-.008Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />`,
    title: 'Stock Lists & Watchlists',
    desc: 'Group stocks into sectors, themes or a screen you ran elsewhere, then ask any analysis of the whole list instead of one name.',
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" />`,
    title: 'Notes per Stock',
    desc: 'Keep rich text against each stock, and a note against each valuation recording what you were underwriting at the time.',
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M9.568 3H5.25A2.25 2.25 0 0 0 3 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 0 0 5.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 0 0 9.568 3Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M6 6h.008v.008H6V6Z" />`,
    title: 'Stock Tags',
    desc: 'Label by sector, conviction or anything you define, then filter and analyse by the label.',
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18 9 11.25l4.306 4.306a11.95 11.95 0 0 1 5.814-5.518l2.74-1.22m0 0-5.94-2.281m5.94 2.28-2.28 5.941" />`,
    title: 'Stocks of Interest',
    desc: 'Track what you do not hold yet, with price anchors on it, beside what you do.',
  },
];

const stageLines: Record<string, string> = {
  'Get your records in':
    'Your broker exports are read and cross-checked, so cost, gains and returns rest on trades that agree with your demat account.',
  'Research and value a stock':
    'Work a list of names through your own reading, then put a number on the ones you would be willing to own.',
  'Decide what to buy and sell':
    'The prices you will act at, and how large each position is meant to grow.',
  'Track the portfolio':
    'Expected and realised return on every holding, with the tax a sale would attract today.',
};

const stageSections: Record<string, any[]> = {
  'Get your records in': [HighlightFundsLedger, HighlightDividends],
  'Research and value a stock': [Screen, ResearchLibrary, HighlightDcf, HighlightReverseDcf],
  'Decide what to buy and sell': [],
  'Track the portfolio': [HighlightXirrTax],
};

const stages = STAGE_ORDER.map((stage) => ({
  stage,
  anchor: stageAnchor(stage),
  line: stageLines[stage],
  sections: stageSections[stage],
  items: coreFeatures.filter((f) => f.stage === stage),
}));

const exchanges = ['NSE', 'BSE'];
---

<section class="pt-32 pb-12">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="reveal gold-line">
      <p class="text-xs text-gold-400 tracking-widest uppercase mb-3">Capabilities</p>
      <h1 class="font-display text-4xl md:text-5xl font-light text-cream">
        What Margin<br /><em class="font-semibold not-italic">does</em>
      </h1>
    </div>
  </div>
</section>

<div>
  <nav class="sticky top-[72px] z-40 bg-navy-900/95 backdrop-blur-md border-y border-border" aria-label="Stages">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <ul class="flex gap-1 py-2 overflow-x-auto">
        {stages.map((group, gi) => (
          <li class="shrink-0">
            <a
              href={`#${group.anchor}`}
              class="stage-link flex items-center gap-2 px-3 sm:px-4 py-2 text-sm font-medium rounded-md text-muted hover:text-ink transition-colors duration-200"
              data-stage={group.anchor}
            >
              <span class="font-display text-gold-400/70 [font-variant-numeric:lining-nums]">{String(gi + 1).padStart(2, '0')}</span>
              {group.stage}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>

  {stages.map((group, gi) => (
    <div class="stage-chapter pt-24 lg:pt-32" data-stage={group.anchor}>
      <header id={group.anchor} class="scroll-mt-40">
        <div class="max-w-7xl mx-auto px-6 lg:px-8">
          <div class="reveal grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-12 items-end pb-8 border-b border-border">
            <div class="lg:col-span-7 flex items-baseline gap-6">
              <p class="font-display text-5xl md:text-6xl font-light text-gold-400/70 leading-none [font-variant-numeric:lining-nums]">{String(gi + 1).padStart(2, '0')}</p>
              <h2 class="font-display text-3xl md:text-4xl font-semibold text-cream">{group.stage}</h2>
            </div>
            <div class="lg:col-span-5">
              <p class="text-sm text-muted leading-relaxed mb-4">{group.line}</p>
              <a
                href={`/guides#${group.anchor}`}
                class="inline-flex items-center gap-2 text-xs text-gold-400 tracking-widest uppercase hover:text-gold-300 transition-colors group"
              >
                Guides for this stage
                <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                </svg>
              </a>
            </div>
          </div>
        </div>
      </header>

      <div class="[&>section:first-child]:pt-12 lg:[&>section:first-child]:pt-16">
        {group.sections.map((Section) => <Section />)}
      </div>

      {group.items.length > 0 && (
        <div class={`max-w-7xl mx-auto px-6 lg:px-8 ${group.sections.length > 0 ? 'pb-8' : 'pt-12 pb-8'}`}>
          {group.sections.length > 0 && (
            <p class="text-xs text-gold-400 tracking-widest uppercase mb-6 reveal">Also in this stage</p>
          )}
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            {group.items.map((f) => (
              <div class="reveal relative rounded-xl border border-border bg-navy-800/40 overflow-hidden flex flex-col group hover:border-gold-400/30 hover:bg-navy-800/70 transition-all duration-300">
                <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-gold-400/30 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                <div class="p-7 flex-1 flex flex-col gap-4">
                  <div class="flex items-center gap-4">
                    <div class="w-11 h-11 shrink-0 rounded-lg border border-gold-400/20 bg-gold-400/5 flex items-center justify-center group-hover:border-gold-400/40 transition-colors duration-300">
                      <svg class="w-5 h-5 text-gold-400" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" set:html={f.icon} />
                    </div>
                    <h3 class="font-display text-xl font-semibold text-cream">{f.title}</h3>
                  </div>
                  <p class="text-sm text-muted leading-relaxed">{f.desc}</p>
                  {f.badges && (
                    <div class="flex flex-wrap gap-1.5">
                      {f.badges.map((b) => (
                        <span class="px-2 py-0.5 text-xs text-muted border border-border rounded">{b}</span>
                      ))}
                    </div>
                  )}
                </div>
                {f.guide && (
                  <a
                    href={f.guide}
                    class="flex items-center justify-between gap-2 px-7 py-4 border-t border-border text-sm text-muted hover:text-cream hover:bg-navy-700/40 transition-colors group/link"
                  >
                    Read the guide
                    <svg class="w-4 h-4 group-hover/link:translate-x-1 transition-transform" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                    </svg>
                  </a>
                )}
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  ))}
</div>

<section class="pt-24 pb-24 lg:pb-32">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="reveal flex flex-col sm:flex-row sm:items-center gap-4 rounded-xl border border-border bg-navy-800/30 px-6 py-5">
      <div class="flex gap-2 shrink-0">
        {exchanges.map((e) => (
          <span class="px-3 py-1 text-xs font-medium text-gold-400 border border-gold-400/20 rounded-full bg-gold-400/5">{e}</span>
        ))}
      </div>
      <p class="text-sm text-muted leading-relaxed">
        Every stock on both exchanges is covered. Prices come from the exchange bhavcopy at the close,
        so every quote is end of day, and Margin shows you the date of the one you are reading.
      </p>
    </div>

    <div class="mt-16">
      <p class="text-xs text-gold-400 tracking-widest uppercase mb-6 reveal">Organise and track</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {organising.map((item, i) => (
          <div class={`reveal reveal-delay-${i + 1} p-6 rounded-xl border border-border bg-navy-800/30 hover:bg-navy-800/60 hover:border-gold-400/20 transition-all duration-300`}>
            <div class="mb-4">
              <svg class="w-5 h-5 text-gold-400" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" set:html={item.icon} />
            </div>
            <h3 class="font-display text-lg font-semibold text-cream mb-2">{item.title}</h3>
            <p class="text-sm text-muted leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const links = document.querySelectorAll<HTMLElement>('.stage-link');
  const chapters = document.querySelectorAll<HTMLElement>('.stage-chapter');

  const setActive = (stage: string) => {
    links.forEach((link) => {
      const active = link.dataset.stage === stage;
      link.classList.toggle('bg-navy-600', active);
      link.classList.toggle('text-cream', active);
      link.classList.toggle('text-muted', !active);
      if (active) {
        const list = link.closest('ul')!;
        list.scrollTo({ left: link.offsetLeft - list.offsetLeft - 16, behavior: 'smooth' });
      }
    });
  };

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) setActive((entry.target as HTMLElement).dataset.stage!);
      });
    },
    { rootMargin: '-45% 0px -50% 0px' },
  );

  chapters.forEach((chapter) => observer.observe(chapter));
</script>
