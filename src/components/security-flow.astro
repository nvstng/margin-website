<div class="rounded-2xl border border-navy-600 bg-navy-800 p-4 lg:p-6">
  <svg
    viewBox="0 0 480 410"
    class="w-full font-sans"
    role="img"
    aria-label="Your funds statement stays on your computer and only dates and amounts reach Margin. At Margin, your portfolio and your name and email are kept apart, so leaked records would show no names."
  >
    <defs>
      <marker id="security-arrow-gold" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 0 L 10 5 L 0 10 z" class="fill-gold-400" />
      </marker>
    </defs>

    <rect x="20" y="20" width="440" height="120" rx="14" class="fill-navy-900 stroke-navy-400" fill-opacity="0.5" stroke-dasharray="5 5" />
    <text x="36" y="42" class="fill-gold-400 text-[11px] tracking-[0.2em] uppercase">On your computer</text>

    <rect x="40" y="54" width="400" height="70" rx="10" class="fill-navy-700 stroke-navy-400" />
    <text x="240" y="82" text-anchor="middle" class="fill-cream text-[17px] font-display font-semibold">Funds statement</text>
    <text x="240" y="106" text-anchor="middle" class="fill-muted text-[12.5px]">your bank details stay here</text>

    <line x1="170" y1="124" x2="170" y2="222" class="stroke-gold-400" stroke-width="1.5" marker-end="url(#security-arrow-gold)" />
    <text x="180" y="168" class="fill-gold-400 text-[12.5px]">only dates and amounts</text>

    <rect x="20" y="184" width="440" height="210" rx="14" class="fill-navy-900 stroke-navy-400" fill-opacity="0.5" stroke-dasharray="5 5" />
    <text x="36" y="206" class="fill-gold-400 text-[11px] tracking-[0.2em] uppercase">At Margin</text>

    <rect x="40" y="222" width="170" height="116" rx="10" class="fill-navy-700 stroke-navy-400" />
    <text x="125" y="252" text-anchor="middle" class="fill-cream text-[17px] font-display font-semibold">Your portfolio</text>
    <text x="125" y="278" text-anchor="middle" class="fill-muted text-[12.5px]">holdings</text>
    <text x="125" y="297" text-anchor="middle" class="fill-muted text-[12.5px]">trades</text>
    <text x="125" y="316" text-anchor="middle" class="fill-muted text-[12.5px]">amounts</text>

    <rect x="270" y="222" width="170" height="116" rx="10" class="fill-navy-700 stroke-gold-400" stroke-opacity="0.65" />
    <text x="355" y="252" text-anchor="middle" class="fill-cream text-[17px] font-display font-semibold">Locked vault</text>
    <text x="355" y="278" text-anchor="middle" class="fill-muted text-[12.5px]">your name</text>
    <text x="355" y="297" text-anchor="middle" class="fill-muted text-[12.5px]">your email</text>
    <text x="355" y="316" text-anchor="middle" class="fill-muted text-[12.5px]">encrypted</text>

    <g class="stroke-gold-400" fill="none" stroke-width="1.5">
      <path d="M 234 266 v -5 a 6 6 0 0 1 12 0 v 5" />
      <rect x="230" y="266" width="20" height="15" rx="2" />
    </g>
    <text x="240" y="302" text-anchor="middle" class="fill-muted text-[11px]">kept</text>
    <text x="240" y="316" text-anchor="middle" class="fill-muted text-[11px]">apart</text>

    <text x="240" y="370" text-anchor="middle" class="fill-muted text-[12px] italic">if our records ever leaked, they would show no names</text>
  </svg>
</div>
