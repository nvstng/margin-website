---
const columnX = [24, 256, 488, 720];
const columnCentre = columnX.map((x) => x + 108);

const world = [
  { title: 'Your bank', lines: ['money leaves for the broker', 'and comes back here'] },
  { title: 'The company', lines: ['its shares are what you hold', 'it pays the dividend'] },
  { title: 'The exchange', lines: ['your order is matched here', 'and the last price is set here'] },
  { title: 'Government', lines: ['STT and stamp duty on the trade', 'capital gains tax on the sale'] },
];

const brokerHolds = [
  { title: 'Cash with the broker', note: 'money in, money out, charges' },
  { title: 'Demat holdings', note: 'the shares themselves' },
  { title: 'Trades', note: 'every buy and sell, settled' },
];

const brokerFiles = [
  { title: 'Funds statement', notes: ['one financial year per file'] },
  { title: 'Holdings export', notes: ['what you own today,', 'at the broker’s average cost'] },
  { title: 'Tradebook', notes: ['every fill, with its date,', 'quantity and price'] },
  { title: 'Dividend statement', notes: ['one financial year per file'] },
];

const records = ['Ledger', 'Holdings', 'Trades', 'Dividends'];

const computed = [
  { title: 'Net invested', lines: ['money in less money out', 'money-weighted return'] },
  { title: 'Current value', lines: ['allocation gap', 'expected return on your anchors'] },
  { title: 'Lots, oldest sold first', lines: ['XIRR and realised gain', 'LTCG, STCG, tax if sold today'] },
  { title: 'Dividends in the return', lines: ['cash returned on the ex-date', 'counted inside XIRR'] },
];

const arrowLabels = ['money in, money out', 'dividend', 'your order'];

const fileGlyph = (cx: number, top: number) => {
  const x = cx - 9;
  return {
    body: `M ${x} ${top} H ${x + 11} L ${x + 18} ${top + 7} V ${top + 22} H ${x} Z`,
    fold: `M ${x + 11} ${top} V ${top + 7} H ${x + 18}`,
  };
};
---

<div class="overflow-x-auto -mx-6 px-6 lg:mx-0 lg:px-0">
  <svg
    viewBox="0 0 960 764"
    class="w-full min-w-[760px] font-sans"
    role="img"
    aria-label="Your bank, the company, the exchange and the government meet at your brokerage; the brokerage exports a funds statement, holdings, tradebook and dividend statement, which Margin records as a ledger, holdings, trades and dividends, and from which it works out net invested, current value, lots and tax, and the dividends inside your return"
  >
    <defs>
      <marker id="cm-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 0 L 10 5 L 0 10 z" class="fill-muted" />
      </marker>
      <marker id="cm-arrow-gold" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 0 L 10 5 L 0 10 z" class="fill-gold-400" />
      </marker>
    </defs>

    <text x="24" y="30" class="fill-gold-400 text-[11.5px] tracking-[0.2em] uppercase">Outside Margin</text>

    {world.map((box, i) => (
      <>
        <rect x={columnX[i]} y="48" width="216" height="94" rx="10" class="fill-navy-800 stroke-border" />
        <text x={columnCentre[i]} y="79" text-anchor="middle" class="fill-cream text-[18px] font-display font-semibold">{box.title}</text>
        {box.lines.map((line, li) => (
          <text x={columnCentre[i]} y={104 + li * 18} text-anchor="middle" class="fill-muted text-[12px]">{line}</text>
        ))}
      </>
    ))}

    {arrowLabels.map((label, i) => (
      <>
        <line x1={columnCentre[i]} y1="142" x2={columnCentre[i]} y2="178" class="stroke-muted" stroke-width="1.5" marker-end="url(#cm-arrow)" />
        <text x={columnCentre[i] + 10} y="164" class="fill-muted text-[12px]">{label}</text>
      </>
    ))}

    <rect x="24" y="182" width="680" height="112" rx="12" class="fill-navy-800 stroke-gold-400" fill-opacity="0.55" stroke-opacity="0.4" />
    <text x="44" y="211" class="fill-cream text-[18px] font-display font-semibold">Your brokerage</text>
    <text x="44" y="231" class="fill-muted text-[12px]">one trading account per broker login · Zerodha, Groww, Upstox, AngelOne or Other</text>

    {brokerHolds.map((item, i) => (
      <>
        <circle cx={columnCentre[i] - 92} cy="257" r="2" class="fill-gold-400" fill-opacity="0.65" />
        <text x={columnCentre[i] - 82} y="261" class="fill-cream text-[13px]">{item.title}</text>
        <text x={columnCentre[i] - 82} y="278" class="fill-muted text-[11.5px]">{item.note}</text>
      </>
    ))}

    <path d="M 704 250 H 828 V 148" class="stroke-muted" fill="none" stroke-width="1.5" marker-end="url(#cm-arrow)" />
    <text x="766" y="241" text-anchor="middle" class="fill-muted text-[12px]">charges and taxes</text>

    <path d="M 364 294 V 318 M 132 318 H 828" class="stroke-muted" fill="none" stroke-width="1.5" />
    <text x="378" y="310" class="fill-muted text-[12px]">what your broker exports</text>

    {brokerFiles.map((file, i) => (
      <>
        <line x1={columnCentre[i]} y1="318" x2={columnCentre[i]} y2="340" class="stroke-muted" stroke-width="1.5" marker-end="url(#cm-arrow)" />
        <path d={fileGlyph(columnCentre[i], 344).body} class="fill-navy-700 stroke-muted" stroke-opacity="0.65" stroke-width="1.25" />
        <path d={fileGlyph(columnCentre[i], 344).fold} class="stroke-muted" fill="none" stroke-opacity="0.65" stroke-width="1.25" />
        <text x={columnCentre[i]} y="386" text-anchor="middle" class="fill-cream text-[14.5px] font-display font-semibold">{file.title}</text>
        {file.notes.map((note, ni) => (
          <text x={columnCentre[i]} y={404 + ni * 17} text-anchor="middle" class="fill-muted text-[11.5px]">{note}</text>
        ))}
      </>
    ))}

    <rect x="14" y="450" width="932" height="290" rx="14" class="fill-navy-800 stroke-border" fill-opacity="0.25" stroke-dasharray="5 5" />
    <text x="32" y="476" class="fill-gold-400 text-[11.5px] tracking-[0.2em] uppercase">Margin</text>

    {records.map((record, i) => (
      <>
        <line x1={columnCentre[i]} y1="434" x2={columnCentre[i]} y2="484" class="stroke-gold-400" stroke-opacity="0.5" stroke-width="1.5" marker-end="url(#cm-arrow-gold)" />
        <rect x={columnCentre[i] - 80} y="490" width="160" height="38" rx="19" class="fill-navy-700 stroke-gold-400" stroke-opacity="0.4" />
        <text x={columnCentre[i]} y="515" text-anchor="middle" class="fill-cream text-[16px] font-display font-semibold">{record}</text>
      </>
    ))}

    {computed.map((box, i) => (
      <>
        <line x1={columnCentre[i]} y1="528" x2={columnCentre[i]} y2="572" class="stroke-muted" stroke-width="1.5" marker-end="url(#cm-arrow)" />
        <text x={columnCentre[i]} y="590" text-anchor="middle" class="fill-gold-300 text-[13px]">{box.title}</text>
        {box.lines.map((line, li) => (
          <text x={columnCentre[i]} y={612 + li * 19} text-anchor="middle" class="fill-muted text-[11.5px]">{line}</text>
        ))}
      </>
    ))}

    <path d="M 364 550 H 596" class="stroke-muted" fill="none" stroke-width="1.5" stroke-dasharray="4 4" marker-start="url(#cm-arrow)" marker-end="url(#cm-arrow)" />
    <text x="480" y="542" text-anchor="middle" class="fill-muted text-[12px]">consistency check</text>

    <path d="M 41 668 H 919" class="stroke-muted" fill="none" stroke-width="1.5" stroke-dasharray="4 4" stroke-opacity="0.7" />
    <path d="M 364 668 V 646" class="stroke-muted" fill="none" stroke-width="1.5" marker-end="url(#cm-arrow)" />
    <path d="M 596 668 V 646" class="stroke-muted" fill="none" stroke-width="1.5" marker-end="url(#cm-arrow)" />
    <text x="480" y="694" text-anchor="middle" class="fill-cream text-[13.5px]">Priced and adjusted from the exchange</text>
    <text x="480" y="715" text-anchor="middle" class="fill-muted text-[11.5px]">the last quote, and every split, bonus and demerger applied to the lots and the cost behind them</text>
  </svg>
</div>
