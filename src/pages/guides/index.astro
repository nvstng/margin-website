---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/layout.astro';
import Nav from '../../components/nav.astro';
import Footer from '../../components/footer.astro';
import ConceptMap from '../../components/concept-map.astro';
import { groupByStage } from '../../domain/guide';

const groups = groupByStage(await getCollection('guide'));

const slugify = (stage: string) => stage.toLowerCase().replace(/[^a-z0-9]+/g, '-');
---

<Layout
  title="Guides · Margin"
  description="Product guides that explain how Margin's features map to the concepts of fundamental investing: DCF valuation, Reverse DCF, XIRR, capital gains, and more."
>
  <Nav />

  <main class="pt-32 pb-24">
    <div class="max-w-4xl mx-auto px-6 lg:px-8">

      <div class="reveal mb-16">
        <p class="text-xs text-gold-400 tracking-widest uppercase mb-4">Guides</p>
        <h1 class="font-display text-5xl md:text-6xl font-light text-cream leading-tight mb-6">
          Learn Margin<br />
          <em class="font-semibold not-italic">in the order you use it</em>
        </h1>
        <p class="text-muted text-lg leading-relaxed max-w-2xl mb-8">
          Walkthroughs of what each Margin feature does, the investing concept behind it, and
          how to use it well. They follow the path a portfolio takes through the product, from the
          files your broker gives you to the tax on a sale you have not made yet. This is the
          product manual, written by people who invest. For broader thinking on investing, see
          <a href="/blog" class="text-gold-400 hover:text-gold-300 transition-colors">Insights</a>.
        </p>

        <div class="flex flex-wrap gap-2">
          {groups.map((group, gi) => (
            <a
              href={`#${slugify(group.stage)}`}
              class="flex items-center gap-2 px-3.5 py-1.5 text-sm text-muted border border-border rounded-full hover:border-gold-400/40 hover:text-cream transition-colors duration-200"
            >
              <span class="text-gold-400 text-xs">{gi + 1}</span>
              {group.stage}
              <span class="text-muted/50 text-xs">{group.items.length}</span>
            </a>
          ))}
        </div>
      </div>

      <section class="reveal reveal-delay-1">
        <h2 class="font-display text-2xl font-light text-cream mb-4 gold-line">
          How the pieces fit together
        </h2>
        <p class="text-muted text-base leading-relaxed max-w-2xl">
          Your money, your shares and your tax all sit with parties outside Margin, and each one
          leaves a file behind. Margin keeps those four files as four records, and every figure in
          the guides below is worked out from them.
        </p>
      </section>
    </div>

    <div class="max-w-6xl mx-auto px-6 lg:px-8 mb-20 mt-8 reveal reveal-delay-1">
      <ConceptMap />
    </div>

    <div class="max-w-4xl mx-auto px-6 lg:px-8">
      <div class="space-y-20">
        {groups.map((group, gi) => (
          <section id={slugify(group.stage)} class={`reveal reveal-delay-${Math.min(gi + 1, 5)} scroll-mt-28`}>
            <div class="flex items-baseline mb-3">
              <span class="w-12 shrink-0 font-sans text-sm tabular-nums text-gold-400/70 tracking-widest">
                {String(gi + 1).padStart(2, '0')}
              </span>
              <h2 class="font-display text-2xl font-light text-cream">
                {group.stage}
              </h2>
            </div>
            {group.blurb && (
              <p class="text-muted text-base leading-relaxed max-w-2xl mb-7 pl-12">
                {group.blurb}
              </p>
            )}

            <ol class="space-y-4 ml-6 pl-6 border-l border-border pb-1">
              {group.items.map((guide) => (
                <li class="group relative">
                  <span class="absolute -left-6 top-7 w-6 h-px bg-border group-hover:bg-gold-400/40 transition-colors duration-300"></span>
                  <a href={`/guides/${guide.slug}`} class="block bg-navy-800/30 border border-border hover:border-gold-400/30 rounded-xl p-6 transition-all duration-300 hover:bg-navy-800/50">
                    <div class="flex items-start justify-between gap-4">
                      <div>
                        <div class="flex flex-wrap items-center gap-2 mb-3">
                          <span class="px-2.5 py-0.5 text-[11px] text-gold-300/80 border border-gold-400/25 rounded-full">
                            {guide.data.feature}
                          </span>
                          {guide.data.readingTime && (
                            <span class="text-[11px] text-muted/60">{guide.data.readingTime}</span>
                          )}
                        </div>
                        <h3 class="font-display text-xl font-light text-cream group-hover:text-gold-200 transition-colors duration-200 mb-2 leading-snug">
                          {guide.data.title}
                        </h3>
                        <p class="text-muted text-sm leading-relaxed">
                          {guide.data.description}
                        </p>
                      </div>
                      <svg class="w-5 h-5 text-gold-400 shrink-0 mt-1 group-hover:translate-x-1 transition-transform duration-200" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3" />
                      </svg>
                    </div>
                  </a>
                </li>
              ))}
            </ol>
          </section>
        ))}
      </div>

    </div>
  </main>

  <Footer />
</Layout>
