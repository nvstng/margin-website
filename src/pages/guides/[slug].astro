---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/layout.astro';
import Nav from '../../components/nav.astro';
import Footer from '../../components/footer.astro';
import SocialShare from '../../components/social-share.astro';
import ProseStyles from '../../components/prose-styles.astro';
import GuideToc from '../../components/guide-toc.astro';
import ImageLightbox from '../../components/image-lightbox.astro';
import GuideVideo from '../../components/guide-video.astro';
import { inReadingOrder } from '../../domain/guide';

export async function getStaticPaths() {
  const ordered = inReadingOrder(await getCollection('guide'));

  return ordered.map((guide, i) => ({
    params: { slug: guide.slug },
    props: {
      guide,
      previous: ordered[i - 1] ?? null,
      next: ordered[i + 1] ?? null,
      siblings: ordered.filter((g) => g.data.stage === guide.data.stage && g.slug !== guide.slug),
    },
  }));
}

const { guide, previous, next, siblings } = Astro.props;
const { Content, headings } = await guide.render();
const pageUrl = new URL(`/guides/${guide.slug}`, Astro.site ?? Astro.url.origin).href;

function formatDate(date: Date) {
  return date.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });
}
---

<Layout title={`${guide.data.title} · Margin Guides`} description={guide.data.description} ogImage={guide.data.ogImage?.src}>
  <Nav />

  <main class="pt-32 pb-24">
    <div class="max-w-6xl mx-auto px-6 lg:px-8 lg:grid lg:grid-cols-[14rem_minmax(0,48rem)] lg:gap-16 lg:justify-center">

      <aside class="hidden lg:block">
        <GuideToc headings={headings} />
      </aside>

      <div class="min-w-0">

      <!-- Back link -->
      <div class="reveal mb-10">
        <a href="/guides" class="inline-flex items-center gap-2 text-sm text-muted hover:text-gold-400 transition-colors duration-200">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
          </svg>
          All Guides
        </a>
      </div>

      <!-- Header -->
      <header class="reveal mb-12">
        <p class="text-xs text-gold-400 tracking-widest uppercase mb-5">
          {guide.data.stage}
          <span class="text-muted/50 mx-1.5">/</span>
          <span class="text-muted">{guide.data.feature}</span>
        </p>
        <h1 class="font-display text-4xl md:text-5xl lg:text-6xl font-light text-cream leading-tight mb-8">
          {guide.data.title}
        </h1>
        <div class="flex items-center gap-6 text-sm text-muted border-t border-border pt-6">
          <span>Updated {formatDate(guide.data.updatedAt)}</span>
          {guide.data.readingTime && (
            <>
              <span class="w-1 h-1 rounded-full bg-border"></span>
              <span>{guide.data.readingTime}</span>
            </>
          )}
        </div>
      </header>

      {guide.data.videos.length > 0 && <GuideVideo title={guide.data.title} videos={guide.data.videos} />}

      <!-- Hero image -->
      {guide.data.ogImage && (
        <div class="reveal mb-12">
          <img
            src={guide.data.ogImage.src}
            alt={guide.data.title}
            width={guide.data.ogImage.width}
            height={guide.data.ogImage.height}
            decoding="async"
            class="w-full rounded-xl border border-border"
          />
        </div>
      )}

      <!-- Guide body -->
      <div class="reveal prose-margin">
        <Content />
      </div>

      <!-- Social share -->
      <SocialShare title={guide.data.title} url={pageUrl} />

      {siblings.length > 0 && (
        <section class="reveal mt-16">
          <h2 class="font-display text-2xl font-light text-cream mb-6 gold-line">
            Also under {guide.data.stage.toLowerCase()}
          </h2>
          <div class="space-y-3">
            {siblings.map((sibling) => (
              <a href={`/guides/${sibling.slug}`} class="group block bg-navy-800/30 border border-border hover:border-gold-400/30 rounded-xl p-5 transition-all duration-300 hover:bg-navy-800/50">
                <h3 class="font-display text-lg font-light text-cream group-hover:text-gold-200 transition-colors duration-200 mb-1.5 leading-snug">
                  {sibling.data.title}
                </h3>
                <p class="text-muted text-sm leading-relaxed">{sibling.data.description}</p>
              </a>
            ))}
          </div>
        </section>
      )}

      <nav class="reveal mt-12 grid grid-cols-1 sm:grid-cols-2 gap-4 border-t border-border pt-8">
        {previous ? (
          <a href={`/guides/${previous.slug}`} class="group block">
            <p class="text-xs text-muted tracking-widest uppercase mb-2">Previous</p>
            <p class="text-sm text-ink group-hover:text-gold-300 transition-colors leading-snug">
              {previous.data.title}
            </p>
          </a>
        ) : <span></span>}
        {next && (
          <a href={`/guides/${next.slug}`} class="group block sm:text-right">
            <p class="text-xs text-muted tracking-widest uppercase mb-2">Next</p>
            <p class="text-sm text-ink group-hover:text-gold-300 transition-colors leading-snug">
              {next.data.title}
            </p>
          </a>
        )}
      </nav>

      <!-- CTA -->
      <div class="reveal mt-16 bg-navy-800/30 border border-gold-400/20 rounded-xl p-8 text-center">
        <p class="text-xs text-gold-400 tracking-widest uppercase mb-4">Try Margin</p>
        <h2 class="font-display text-3xl font-light text-cream mb-4">
          Put this into practice
        </h2>
        <p class="text-muted text-sm leading-relaxed mb-6 max-w-md mx-auto">
          Margin gives you DCF valuation, Reverse DCF, XIRR and capital gains tracking in one place. Free, no credit card required.
        </p>
        <a
          href="https://go.marginapp.in"
          class="inline-flex items-center px-6 py-3 text-sm font-medium text-navy-900 bg-gold-400 hover:bg-gold-300 rounded transition-colors duration-200 tracking-wide"
        >
          Start for free
        </a>
      </div>

      </div>
    </div>
  </main>

  <Footer />
  <ImageLightbox />
</Layout>

<ProseStyles />
