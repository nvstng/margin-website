---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/layout.astro';
import Nav from '../../components/nav.astro';
import Footer from '../../components/footer.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

function formatDate(date: Date) {
  return date.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });
}
---

<Layout title={`${post.data.title} — Margin Insights`} description={post.data.description}>
  <Nav />

  <main class="pt-32 pb-24">
    <div class="max-w-3xl mx-auto px-6 lg:px-8">

      <!-- Back link -->
      <div class="reveal mb-10">
        <a href="/blog" class="inline-flex items-center gap-2 text-sm text-muted hover:text-gold-400 transition-colors duration-200">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
          </svg>
          All Insights
        </a>
      </div>

      <!-- Header -->
      <header class="reveal mb-12">
        <p class="text-xs text-gold-400 tracking-widest uppercase mb-5">{post.data.category}</p>
        <h1 class="font-display text-4xl md:text-5xl lg:text-6xl font-light text-cream leading-tight mb-8">
          {post.data.title}
        </h1>
        <div class="flex items-center gap-6 text-sm text-muted border-t border-border pt-6">
          <span>{post.data.author}</span>
          <span class="w-1 h-1 rounded-full bg-border"></span>
          <span>{formatDate(post.data.publishedAt)}</span>
          <span class="w-1 h-1 rounded-full bg-border"></span>
          <span>{post.data.readingTime}</span>
        </div>
      </header>

      <!-- Article body -->
      <div class="reveal prose-margin">
        <Content />
      </div>

      <!-- CTA -->
      <div class="reveal mt-20 bg-navy-800/30 border border-gold-400/20 rounded-xl p-8 text-center">
        <p class="text-xs text-gold-400 tracking-widest uppercase mb-4">Try Margin</p>
        <h2 class="font-display text-3xl font-light text-cream mb-4">
          Put this into practice
        </h2>
        <p class="text-muted text-sm leading-relaxed mb-6 max-w-md mx-auto">
          Margin gives you DCF valuation, Reverse DCF, XIRR, and capital gains tracking — all in one place. Free, no credit card required.
        </p>
        <a
          href="/#signup"
          class="inline-flex items-center px-6 py-3 text-sm font-medium text-navy-900 bg-gold-400 hover:bg-gold-300 rounded transition-colors duration-200 tracking-wide"
        >
          Start for free
        </a>
      </div>

    </div>
  </main>

  <Footer />
</Layout>

<style is:global>
  .prose-margin h2 {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.75rem;
    font-weight: 300;
    color: #F2EBD9;
    margin-top: 3rem;
    margin-bottom: 1rem;
    line-height: 1.3;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid #1A2D4A;
  }
  .prose-margin h3 {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.35rem;
    font-weight: 400;
    color: #D8E4F0;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }
  .prose-margin p {
    color: #8AABCC;
    font-size: 1rem;
    line-height: 1.85;
    margin-bottom: 1.5rem;
  }
  .prose-margin strong {
    color: #D8E4F0;
    font-weight: 500;
  }
  .prose-margin em {
    color: #D8E4F0;
    font-style: italic;
  }
  .prose-margin ul {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
    list-style: none;
  }
  .prose-margin ul li {
    color: #8AABCC;
    font-size: 1rem;
    line-height: 1.85;
    margin-bottom: 0.5rem;
    position: relative;
    padding-left: 0.5rem;
  }
  .prose-margin ul li::before {
    content: '—';
    position: absolute;
    left: -1.25rem;
    color: #E8B84B;
    font-size: 0.85rem;
  }
  .prose-margin ol {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
    list-style: decimal;
  }
  .prose-margin ol li {
    color: #8AABCC;
    font-size: 1rem;
    line-height: 1.85;
    margin-bottom: 0.5rem;
    padding-left: 0.25rem;
  }
  .prose-margin ol li::marker {
    color: #E8B84B;
  }
  .prose-margin blockquote {
    border-left: 2px solid #E8B84B;
    margin: 2rem 0;
    padding: 0.5rem 0 0.5rem 1.5rem;
    background: rgba(10, 24, 40, 0.4);
    border-radius: 0 8px 8px 0;
  }
  .prose-margin blockquote p {
    margin-bottom: 0;
    color: #D8E4F0;
    font-style: italic;
  }
  .prose-margin code {
    font-family: 'Sora', monospace;
    font-size: 0.875rem;
    background: rgba(10, 24, 40, 0.8);
    border: 1px solid #1A2D4A;
    border-radius: 4px;
    padding: 0.1em 0.4em;
    color: #E8B84B;
  }
  .prose-margin hr {
    border: none;
    border-top: 1px solid #1A2D4A;
    margin: 2.5rem 0;
  }
  .prose-margin img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid #1A2D4A;
    border-radius: 8px;
    background: #000;
    margin: 0;
  }
  .prose-margin p:has(img) {
    margin: 2rem 0 0.75rem;
  }
  .prose-margin p:has(img) + p:has(em:only-child) {
    text-align: center;
    font-size: 0.85rem;
    margin-top: 0;
  }
  .prose-margin p:has(img) + p:has(em:only-child) em {
    color: #8AABCC;
  }
  .prose-margin a {
    color: #E8B84B;
    text-decoration: underline;
    text-decoration-color: rgba(232, 184, 75, 0.3);
    transition: color 0.2s;
  }
  .prose-margin a:hover {
    color: #F5D070;
  }
</style>
