---
import Layout from '../layouts/layout.astro';
import Nav from '../components/nav.astro';
import Footer from '../components/footer.astro';
---

<Layout
  title="Company — Yuktibyte Products Private Limited"
  description="Learn about Yuktibyte Products Private Limited, the company behind Margin — your personal investment cockpit for Indian equities."
>
  <Nav />

  <main class="pt-32 pb-24">
    <div class="max-w-4xl mx-auto px-6 lg:px-8">

      <div class="reveal mb-16">
        <p class="text-xs text-gold-400 tracking-widest uppercase mb-4">The Company</p>
        <h1 class="font-display text-5xl md:text-6xl font-light text-cream leading-tight mb-6">
          Yuktibyte Products<br />
          <em class="font-semibold not-italic">Private Limited</em>
        </h1>
        <p class="text-muted text-lg leading-relaxed max-w-2xl">
          We build focused, high-quality tools for serious Indian equity investors.
          Margin is our first product — a personal investment cockpit that brings
          institutional-grade analysis to individual portfolios.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-20 reveal reveal-delay-1">
        <div class="bg-navy-800/30 border border-border rounded-xl p-6">
          <p class="text-xs text-gold-400 tracking-widest uppercase mb-2">Founded</p>
          <p class="text-cream text-xl font-light">January 2025</p>
        </div>
        <div class="bg-navy-800/30 border border-border rounded-xl p-6">
          <p class="text-xs text-gold-400 tracking-widest uppercase mb-2">Headquartered</p>
          <p class="text-cream text-xl font-light">Bangalore, India</p>
        </div>
        <div class="bg-navy-800/30 border border-border rounded-xl p-6">
          <p class="text-xs text-gold-400 tracking-widest uppercase mb-2">Product</p>
          <p class="text-cream text-xl font-light">Margin</p>
        </div>
      </div>

      <div class="mb-20 reveal">
        <h2 class="font-display text-3xl font-light text-cream mb-8 gold-line">Founders</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="bg-navy-800/30 border border-border rounded-xl p-8">
            <p class="text-cream text-xl font-medium mb-1">Vivek Singh</p>
            <p class="text-xs text-gold-400 tracking-widest uppercase mb-5">Director</p>
            <a
              href="https://www.linkedin.com/in/vivek-singh-4535a61/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-sm text-muted hover:text-gold-400 transition-colors duration-200"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
              LinkedIn Profile
            </a>
          </div>

          <div class="bg-navy-800/30 border border-border rounded-xl p-8">
            <p class="text-cream text-xl font-medium mb-1">Pradipta Kundu</p>
            <p class="text-xs text-gold-400 tracking-widest uppercase mb-5">Director</p>
            <a
              href="https://www.linkedin.com/in/pradiptakundu/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-sm text-muted hover:text-gold-400 transition-colors duration-200"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
              LinkedIn Profile
            </a>
          </div>
        </div>
      </div>

      <div class="reveal">
        <h2 class="font-display text-3xl font-light text-cream mb-8 gold-line">Legal & Registration</h2>
        <div class="bg-navy-800/30 border border-border rounded-xl overflow-hidden">
          <table class="w-full text-sm">
            <tbody>
              <tr class="border-b border-border/50">
                <td class="px-6 py-4 text-muted w-1/3">Legal Name</td>
                <td class="px-6 py-4 text-cream font-medium">Yuktibyte Products Private Limited</td>
              </tr>
              <tr class="border-b border-border/50">
                <td class="px-6 py-4 text-muted">CIN</td>
                <td class="px-6 py-4 text-cream font-mono tracking-wide">U62099KA2025PTC196482</td>
              </tr>
              <tr class="border-b border-border/50">
                <td class="px-6 py-4 text-muted">PAN</td>
                <td class="px-6 py-4 text-cream font-mono tracking-wide">AABCY9366P</td>
              </tr>
              <tr class="border-b border-border/50">
                <td class="px-6 py-4 text-muted">TAN</td>
                <td class="px-6 py-4 text-cream font-mono tracking-wide">BLRY03553E</td>
              </tr>
              <tr>
                <td class="px-6 py-4 text-muted align-top">Registered Address</td>
                <td class="px-6 py-4 text-cream leading-relaxed">
                  No. 20, T P Venugopal Layout, Anand Nagar,<br />
                  Hebbal Kempapura, Bangalore North,<br />
                  Bangalore – 560024, Karnataka, India
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

    </div>
  </main>

  <Footer />
</Layout>
