---
import { getCollection } from 'astro:content';
import Layout from '../layouts/layout.astro';
import Nav from '../components/nav.astro';
import Footer from '../components/footer.astro';

const YOUTUBE_URL = 'https://www.youtube.com/@margin-fundamental';

const guides = await getCollection('guide');
const posts = await getCollection('blog');
const recipes = await getCollection('recipe');

const sections = [
  {
    eyebrow: 'Guides',
    title: 'How to use each Margin feature well',
    body:
      'Each guide takes one feature, explains the investing concept it exists to serve, and shows how to use it. They run in the order a portfolio moves through Margin, from your broker’s files to the tax on a sale you have not made. Start here if you have an account and want more out of it.',
    meta: `${guides.length} guides`,
    href: '/guides',
    cta: 'Read the guides',
    external: false,
  },
  {
    eyebrow: 'Insights',
    title: 'Writing on how investing actually works',
    body:
      'Essays on valuation, market behaviour and the habits that decide long-run results. These are about investing and not about the product, and they hold up whether or not you use Margin.',
    meta: `${posts.length} essays`,
    href: '/blog',
    cta: 'Read the essays',
    external: false,
  },
  {
    eyebrow: 'Agent recipes',
    title: 'Hand the repetitive work to a skill you write once',
    body:
      'Margin publishes an API and a machine-readable guide for AI agents. These recipes cover importing your records, moving a valuation in, and wiring what Margin computes back out to your broker, each with a skill to copy and adapt.',
    meta: `${recipes.length} recipes`,
    href: '/agents',
    cta: 'See the recipes',
    external: false,
  },
  {
    eyebrow: 'Stock stories',
    title: 'Companies and industries, on video',
    body:
      'Narrated walkthroughs of individual businesses and the industries they sit in, covering what the company does, how it earns, and what its recent story has been.',
    meta: 'YouTube',
    href: YOUTUBE_URL,
    cta: 'Watch on YouTube',
    external: true,
  },
];
---

<Layout
  title="Learn · Margin"
  description="Guides to Margin's features, essays on how investing works, agent recipes for automating the repetitive parts, and stock stories on video."
>
  <Nav />

  <main class="pt-32 pb-24">
    <div class="max-w-4xl mx-auto px-6 lg:px-8">

      <div class="reveal mb-16">
        <p class="text-xs text-gold-400 tracking-widest uppercase mb-4">Learn</p>
        <h1 class="font-display text-5xl md:text-6xl font-light text-cream leading-tight mb-6">
          Four places to start,<br />
          <em class="font-semibold not-italic">depending on what you want</em>
        </h1>
        <p class="text-muted text-lg leading-relaxed max-w-2xl">
          Some of what follows is about the product and some of it is about investing. We keep the
          two apart so you can read either one on its own.
        </p>
      </div>

      <div class="space-y-5">
        {sections.map((section, i) => (
          <a
            href={section.href}
            target={section.external ? '_blank' : undefined}
            rel={section.external ? 'noopener' : undefined}
            class={`group block bg-navy-800/30 border border-border hover:border-gold-400/30 rounded-xl p-8 transition-all duration-300 hover:bg-navy-800/50 reveal reveal-delay-${Math.min(i + 1, 5)}`}
          >
            <div class="flex items-start justify-between gap-6">
              <div>
                <div class="flex items-center gap-3 mb-3">
                  <p class="text-xs text-gold-400 tracking-widest uppercase">{section.eyebrow}</p>
                  <span class="w-1 h-1 rounded-full bg-border"></span>
                  <p class="text-xs text-muted tracking-wide">{section.meta}</p>
                </div>
                <h2 class="font-display text-2xl font-light text-cream group-hover:text-gold-200 transition-colors duration-200 mb-3 leading-snug">
                  {section.title}
                </h2>
                <p class="text-muted text-sm leading-relaxed mb-5 max-w-xl">
                  {section.body}
                </p>
                <span class="inline-flex items-center gap-2 text-sm font-medium text-gold-400">
                  {section.cta}
                  <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform duration-200" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0l-7.5 7.5M21 12H3" />
                  </svg>
                </span>
              </div>
            </div>
          </a>
        ))}
      </div>

      <div class="reveal mt-16 text-center">
        <p class="text-muted text-sm leading-relaxed">
          Margin also keeps a research library inside the app, with stock stories and quick
          stories generated against the companies you follow.
          <a href="/#research" class="text-gold-400 hover:text-gold-300 transition-colors">See what it holds</a>.
        </p>
      </div>

    </div>
  </main>

  <Footer />
</Layout>
